// ---------------------------------------------------------------------------
// Flipped NSView & Custom Drawing NSView
// ---------------------------------------------------------------------------

def gCustomDrawAssocKey: Ptr = ptrAllocBytes(8)

def flippedViewIsFlipped(_self: Ptr, _cmd: Ptr): Bool = {
    let _ = _self;
    let _ = _cmd;
    true
}

def customDrawViewDrawRect(self: Ptr, _cmd: Ptr, dirtyRect: CGRect): Void = {
    let _ = _cmd;
    let h = objcGetAssocHandle(self, gCustomDrawAssocKey);
    if (h != intToI64(0)) {
        let cb: (Ptr, CGRect) -> Void = gcHandleGet(h);
        cb(self, dirtyRect)
    } else ()
}

def ensureTalusViewClasses(): Void = {
    if (ptrIsNull(objcClass("TalusFlippedView"))) {
        let fCls = objcAllocateClass("NSView", "TalusFlippedView");
        if (!ptrIsNull(fCls)) {
            let _ = objcAddMethod(fCls, "isFlipped", cFnPtr(flippedViewIsFlipped), "B@:");
            objcRegisterClass(fCls)
        } else ()
    } else ();
    if (ptrIsNull(objcClass("TalusCustomDrawView"))) {
        let dCls = objcAllocateClass("NSView", "TalusCustomDrawView");
        if (!ptrIsNull(dCls)) {
            let _ = objcAddMethod(dCls, "drawRect:", cFnPtr(customDrawViewDrawRect), "v@:{CGRect={CGPoint=dd}{CGSize=dd}}");
            objcRegisterClass(dCls)
        } else ()
    } else ()
}

pub def makeFlippedView(frame: CGRect): Id NSObject = {
    ensureTalusViewClasses();
    let cls = objcClass("TalusFlippedView");
    let raw = msgSend1Rect(msgSend0(cls, objcSel("alloc")), objcSel("initWithFrame:"), frame);
    idAdopt(raw)
}

pub def makeCustomDrawView(frame: CGRect, drawFn: (Ptr, CGRect) -> Void): Id NSObject = {
    ensureTalusViewClasses();
    let cls = objcClass("TalusCustomDrawView");
    let raw = msgSend1Rect(msgSend0(cls, objcSel("alloc")), objcSel("initWithFrame:"), frame);
    objcSetAssocHandle(raw, gCustomDrawAssocKey, gcHandleNew(drawFn));
    idAdopt(raw)
}

// ---------------------------------------------------------------------------
// Hover tracking delegate (mouseMoved:/mouseExited:)
// ---------------------------------------------------------------------------

def gHoverAssocKey: Ptr = ptrAllocBytes(8)

def hoverMouseMoved(self: Ptr, _cmd: Ptr, _ev: Ptr): Void = {
    let _ = _cmd;
    let _ = _ev;
    let h = objcGetAssocHandle(self, gHoverAssocKey);
    if (h != intToI64(0)) {
        let pair: (() -> Void, () -> Void) = gcHandleGet(h);
        let (onMove, _) = pair;
        onMove()
    } else ()
}

def hoverMouseExited(self: Ptr, _cmd: Ptr, _ev: Ptr): Void = {
    let _ = _cmd;
    let _ = _ev;
    let h = objcGetAssocHandle(self, gHoverAssocKey);
    if (h != intToI64(0)) {
        let pair: (() -> Void, () -> Void) = gcHandleGet(h);
        let (_, onExit) = pair;
        onExit()
    } else ()
}

def ensureHoverTrackerClass(): Ptr = {
    let existing = objcClass("TalusHoverTracker");
    if (!ptrIsNull(existing)) existing
    else {
        let cls = objcAllocateClass("NSObject", "TalusHoverTracker");
        if (!ptrIsNull(cls)) {
            let _ = objcAddMethod(cls, "mouseMoved:", cFnPtr(hoverMouseMoved), "v@:@");
            let _ = objcAddMethod(cls, "mouseExited:", cFnPtr(hoverMouseExited), "v@:@");
            objcRegisterClass(cls)
        } else ();
        objcClass("TalusHoverTracker")
    }
}

pub def makeHoverTracker(onMove: () -> Void, onExit: () -> Void): Id NSObject = {
    let cls = ensureHoverTrackerClass();
    let raw = msgSend0(msgSend0(cls, objcSel("alloc")), objcSel("init"));
    objcSetAssocHandle(raw, gHoverAssocKey, gcHandleNew((onMove, onExit)));
    idAdopt(raw)
}

