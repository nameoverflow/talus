/// Internal AppKit Objective-C wrapper layer for Talus (graphics, screens, status bar, menus,
/// notifications, windows, and form controls). Kept strictly inside Talus per package boundary rules.

use std.option.{Option, Some, None}
use std.list.{listRev}
use objc.{
    Id, NSObject, NSString,
    objcClass, objcSel, idRetain, idAdopt, idRetainOpt, idAdoptOpt,
    withId, withAutoreleasePool, nsString, fromNSString, fromNSStringPtr,
    objcAllocateClass, objcAddMethod, objcRegisterClass,
    objcSetAssocHandle, objcGetAssocHandle,
    objcBlock0, objcBlock1Ptr, objcBlockCustom, objcBlockHandle,
    msgSend0, msgSend1Ptr, msgSend2Ptr, msgSend3Ptr,
    msgSend1Int, msgSend1I64, msgSend1Float, msgSend1Bool,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid2Ptr, msgSendVoid1Int, msgSendVoid1I64, msgSendVoid1Bool, msgSendVoid1Float,
    msgSendBool0, msgSendInt0, msgSendI64_0, msgSendFloat0
}
use layout.{Rect, rectNew}
use manager.{ScreenSpec}
use macos.ffi.{
    CGPoint, CGSize, CGRect, cgPoint, cgSize, cgRect, rectToCG, cgToRect,
    resolveGlobalPtr,
    msgSendRect0, msgSendSize0, msgSendPoint0, msgSendPoint1Point, msgSendPoint1Point1Ptr,
    msgSendRect1Rect, msgSend1Rect, msgSendVoid1Rect, msgSendVoid1Size, msgSendVoid1Point,
    msgSend1Rect2Float, msgSend1Size1Bool1Ptr, msgSend1Float1Float, msgSend4Float,
    msgSend1Ptr1Float, msgSend1Ptr1Ptr, msgSendSize1Ptr, msgSendVoid1Point1Ptr,
    msgSendVoid1Rect1Rect1I641Float, msgSendVoid1Rect1I64,
    msgSend1Ptr1Bool, msgSend1I641Ptr, msgSendBool1Ptr,
    msgSend1Ptr1Ptr1Ptr1Ptr, msgSend1Float1Ptr1Ptr1Ptr1Bool,
    msgSend1Rect1I641I641Bool, msgSend1Rect1I641Ptr1Ptr, msgSend1Ptr1I641Ptr,
    msgSendVoid1Ptr1Ptr, msgSendVoid1Ptr1Ptr1Ptr1Ptr, msgSendVoid1Ptr1Ptr1Ptr1Ptr1I64,
    nsArrayCount, nsArrayObjectAt, nsDictGet, nsNumberIntOpt
}

