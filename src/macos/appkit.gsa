// ---------------------------------------------------------------------------
// Common AppKit view/control helpers
// ---------------------------------------------------------------------------

pub def nsViewAddSubview(parent: Ptr, child: Ptr): Void =
    msgSendVoid1Ptr(parent, objcSel("addSubview:"), child)

pub def nsViewSetWantsLayer(view: Ptr, wants: Bool): Void =
    msgSendVoid1Bool(view, objcSel("setWantsLayer:"), wants)

pub def nsViewSetLayerStyle(view: Ptr, bgOpt: Option Ptr, borderOpt: Option Ptr, borderWidth: Float, cornerRadius: Float): Void = {
    nsViewSetWantsLayer(view, true);
    let layer = msgSend0(view, objcSel("layer"));
    if (!ptrIsNull(layer)) {
        match bgOpt {
            Some(c) -> msgSendVoid1Ptr(layer, objcSel("setBackgroundColor:"), nsColorCGColor(c)),
            None -> (),
        };
        match borderOpt {
            Some(c) -> {
                msgSendVoid1Ptr(layer, objcSel("setBorderColor:"), nsColorCGColor(c));
                msgSendVoid1Float(layer, objcSel("setBorderWidth:"), borderWidth)
            },
            None -> (),
        };
        if (cornerRadius > 0.0) {
            msgSendVoid1Float(layer, objcSel("setCornerRadius:"), cornerRadius);
            msgSendVoid1Bool(layer, objcSel("setMasksToBounds:"), true)
        } else ()
    } else ()
}

pub def makeLabel(text: String, frame: CGRect, font: Ptr, color: Ptr): Id NSObject = {
    let ns = nsString(text);
    let raw = withId(ns, (np) -> {
        c_lbl(objcClass("NSTextField"), objcSel("labelWithString:"), np)
    });
    let id = idRetain(raw);
    msgSendVoid1Rect(raw, objcSel("setFrame:"), frame);
    msgSendVoid1Ptr(raw, objcSel("setFont:"), font);
    msgSendVoid1Ptr(raw, objcSel("setTextColor:"), color);
    msgSendVoid1I64(raw, objcSel("setLineBreakMode:"), intToI64(0)); // NSLineBreakByWordWrapping
    id
}

pub def makeTextField(value: String, placeholder: String, frame: CGRect, font: Ptr): Id NSObject = {
    let raw = msgSend1Rect(msgSend0(objcClass("NSTextField"), objcSel("alloc")), objcSel("initWithFrame:"), frame);
    let id = idAdopt(raw);
    let vNs = nsString(value);
    let pNs = nsString(placeholder);
    withId(vNs, (vp) -> {
        c_sv(raw, objcSel("setStringValue:"), vp)
    });
    withId(pNs, (pp) -> {
        c_sp(raw, objcSel("setPlaceholderString:"), pp)
    });
    msgSendVoid1Ptr(raw, objcSel("setFont:"), font);
    msgSendVoid1Bool(raw, objcSel("setBezeled:"), true);
    msgSendVoid1I64(raw, objcSel("setBezelStyle:"), intToI64(1)); // NSTextFieldRoundedBezel
    id
}

pub def textFieldStringValue(tf: Ptr): String =
    fromNSStringPtr(msgSend0(tf, objcSel("stringValue")))

pub def textFieldSetStringValue(tf: Ptr, value: String): Void = {
    let ns = nsString(value);
    withId(ns, (vp) -> {
        c_sv2(tf, objcSel("setStringValue:"), vp)
    })
}

pub def makePushButton(title: String, frame: CGRect, target: Id NSObject): Id NSObject = {
    let ns = nsString(title);
    let raw = withId(ns, (tp) -> withId(target, (tgp) -> {
        c_btn(objcClass("NSButton"), objcSel("buttonWithTitle:target:action:"), tp, tgp, actionTargetSel())
    }));
    let id = idRetain(raw);
    msgSendVoid1Rect(raw, objcSel("setFrame:"), frame);
    id
}

pub def makeCheckbox(title: String, checked: Bool, frame: CGRect, target: Id NSObject): Id NSObject = {
    let ns = nsString(title);
    let raw = withId(ns, (tp) -> withId(target, (tgp) -> {
        c_chk(objcClass("NSButton"), objcSel("checkboxWithTitle:target:action:"), tp, tgp, actionTargetSel())
    }));
    let id = idRetain(raw);
    msgSendVoid1Rect(raw, objcSel("setFrame:"), frame);
    msgSendVoid1I64(raw, objcSel("setState:"), if (checked) intToI64(1) else intToI64(0));
    id
}

pub def makeSwitch(checked: Bool, frame: CGRect, target: Id NSObject): Id NSObject = {
    let raw = msgSend1Rect(msgSend0(objcClass("NSSwitch"), objcSel("alloc")), objcSel("initWithFrame:"), frame);
    let id = idAdopt(raw);
    msgSendVoid1I64(raw, objcSel("setState:"), if (checked) intToI64(1) else intToI64(0));
    withId(target, (tgp) -> {
        c_setTgt(raw, objcSel("setTarget:"), tgp)
    });
    msgSendVoid1Ptr(raw, objcSel("setAction:"), actionTargetSel());
    id
}

pub def controlStateOn(ctrl: Ptr): Bool =
    i64ToInt(msgSendI64_0(ctrl, objcSel("state"))) != 0

pub def makePopUpButton(items: List String, selectedIndex: Int, frame: CGRect, target: Id NSObject): Id NSObject = {
    let raw = msgSend1Rect(msgSend0(objcClass("NSPopUpButton"), objcSel("alloc")), objcSel("initWithFrame:"), frame);
    let id = idAdopt(raw);
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(it, rest) -> {
                let ns = nsString(it);
                withId(ns, (ip) -> {
                    c_addIt(raw, objcSel("addItemWithTitle:"), ip)
                });
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    if (selectedIndex >= 0) msgSendVoid1I64(raw, objcSel("selectItemAtIndex:"), intToI64(selectedIndex)) else ();
    withId(target, (tgp) -> {
        c_setTgt2(raw, objcSel("setTarget:"), tgp)
    });
    msgSendVoid1Ptr(raw, objcSel("setAction:"), actionTargetSel());
    id
}

pub def makeSegmentedControl(labels: List String, selectedIndex: Int, frame: CGRect, target: Id NSObject): Id NSObject = {
    let arr = msgSend0(objcClass("NSMutableArray"), objcSel("array"));
    let cur = cellNew(labels);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(lbl, rest) -> {
                let ns = nsString(lbl);
                withId(ns, (lp) -> {
                    c_arrAdd(arr, objcSel("addObject:"), lp)
                });
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    let raw = withId(target, (tgp) -> {
        c_seg(objcClass("NSSegmentedControl"), objcSel("segmentedControlWithLabels:trackingMode:target:action:"), arr, intToI64(0), tgp, actionTargetSel())
    });
    let id = idRetain(raw);
    msgSendVoid1Rect(raw, objcSel("setFrame:"), frame);
    msgSendVoid1I64(raw, objcSel("setSelectedSegment:"), intToI64(selectedIndex));
    id
}

pub def makeSlider(minVal: Float, maxVal: Float, val: Float, frame: CGRect, target: Id NSObject): Id NSObject = {
    let raw = withId(target, (tgp) -> {
        c_sld(objcClass("NSSlider"), objcSel("sliderWithValue:minValue:maxValue:target:action:"), val, minVal, maxVal, tgp, actionTargetSel())
    });
    let id = idRetain(raw);
    msgSendVoid1Rect(raw, objcSel("setFrame:"), frame);
    msgSendVoid1Bool(raw, objcSel("setContinuous:"), true);
    id
}

pub def makeImageView(frame: CGRect, imgOpt: Option (Id NSObject)): Id NSObject = {
    let raw = msgSend1Rect(msgSend0(objcClass("NSImageView"), objcSel("alloc")), objcSel("initWithFrame:"), frame);
    let id = idAdopt(raw);
    match imgOpt {
