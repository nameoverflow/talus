pub def nsColorBlack(): Ptr = msgSend0(objcClass("NSColor"), objcSel("blackColor"))
pub def nsColorWhite(): Ptr = msgSend0(objcClass("NSColor"), objcSel("whiteColor"))
pub def nsColorClear(): Ptr = msgSend0(objcClass("NSColor"), objcSel("clearColor"))
pub def nsColorLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("labelColor"))
pub def nsColorSecondaryLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("secondaryLabelColor"))
pub def nsColorTertiaryLabel(): Ptr = msgSend0(objcClass("NSColor"), objcSel("tertiaryLabelColor"))
pub def nsColorControlAccent(): Ptr = msgSend0(objcClass("NSColor"), objcSel("controlAccentColor"))
pub def nsColorWindowBackground(): Ptr = msgSend0(objcClass("NSColor"), objcSel("windowBackgroundColor"))
pub def nsColorControlBackground(): Ptr = msgSend0(objcClass("NSColor"), objcSel("controlBackgroundColor"))
pub def nsColorSeparator(): Ptr = msgSend0(objcClass("NSColor"), objcSel("separatorColor"))
pub def nsColorSystemRed(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemRedColor"))
pub def nsColorSystemOrange(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemOrangeColor"))
pub def nsColorSystemGreen(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemGreenColor"))
pub def nsColorSystemBlue(): Ptr = msgSend0(objcClass("NSColor"), objcSel("systemBlueColor"))

pub def nsColorSRGB(r: Float, g: Float, b: Float, a: Float): Ptr =
    msgSend4Float(objcClass("NSColor"), objcSel("colorWithSRGBRed:green:blue:alpha:"), r, g, b, a)

pub def nsColorCalibratedWhite(white: Float, alpha: Float): Ptr =
    msgSend1Float1Float(objcClass("NSColor"), objcSel("colorWithCalibratedWhite:alpha:"), white, alpha)

pub def nsColorWithAlpha(color: Ptr, alpha: Float): Ptr =
    msgSend1Float(color, objcSel("colorWithAlphaComponent:"), alpha)

pub def nsColorAlpha(color: Ptr): Float =
    msgSendFloat0(color, objcSel("alphaComponent"))

pub def nsColorSetFill(color: Ptr): Void = msgSendVoid0(color, objcSel("setFill"))
pub def nsColorSetStroke(color: Ptr): Void = msgSendVoid0(color, objcSel("setStroke"))

pub def nsColorCGColor(color: Ptr): Ptr = msgSend0(color, objcSel("CGColor"))

// ---------------------------------------------------------------------------
// NSFont (weights: regular=0.0, medium=0.23, semibold=0.30, bold=0.40)
// ---------------------------------------------------------------------------

pub def kFontWeightRegular(): Float = 0.0
pub def kFontWeightMedium(): Float = 0.23
pub def kFontWeightSemibold(): Float = 0.30
pub def kFontWeightBold(): Float = 0.40

pub def nsFontSystem(size: Float, weight: Float): Ptr =
    msgSend1Float1Float(objcClass("NSFont"), objcSel("systemFontOfSize:weight:"), size, weight)

pub def nsFontMonospacedDigit(size: Float, weight: Float): Ptr =
    msgSend1Float1Float(objcClass("NSFont"), objcSel("monospacedDigitSystemFontOfSize:weight:"), size, weight)

pub def nsFontMonospaced(size: Float, weight: Float): Ptr =
    msgSend1Float1Float(objcClass("NSFont"), objcSel("monospacedSystemFontOfSize:weight:"), size, weight)

pub def nsFontByName(name: String, size: Float): Option Ptr = {
    let ns = nsString(name);
    let f = withId(ns, (np) -> {
        c_fontName(objcClass("NSFont"), objcSel("fontWithName:size:"), np, size)
    });
    if (ptrIsNull(f)) None else Some(f)
}

pub def nsFontCapHeight(font: Ptr): Float = msgSendFloat0(font, objcSel("capHeight"))
pub def nsFontDescender(font: Ptr): Float = msgSendFloat0(font, objcSel("descender"))

// ---------------------------------------------------------------------------
// NSBezierPath & NSRectFillUsingOperation
// ---------------------------------------------------------------------------

// NSCompositingOperation constants
pub def kNSCompositingOperationSourceOver(): Int64 = intToI64(2)
pub def kNSCompositingOperationSourceAtop(): Int64 = intToI64(5)

pub extern "NSRectFillUsingOperation" def c_NSRectFillUsingOperation(rect: CGRect, op: Int64): Void

pub def nsBezierRoundedRect(r: CGRect, rx: Float, ry: Float): Ptr =
    msgSend1Rect2Float(objcClass("NSBezierPath"), objcSel("bezierPathWithRoundedRect:xRadius:yRadius:"), r, rx, ry)

pub def nsBezierFill(path: Ptr): Void = msgSendVoid0(path, objcSel("fill"))
pub def nsBezierStroke(path: Ptr): Void = msgSendVoid0(path, objcSel("stroke"))
pub def nsBezierSetLineWidth(path: Ptr, lw: Float): Void = msgSendVoid1Float(path, objcSel("setLineWidth:"), lw)

pub def nsDrawRoundedRectFill(x: Float, y: Float, w: Float, h: Float, r: Float): Void =
    nsBezierFill(nsBezierRoundedRect(cgRect(x, y, w, h), r, r))

pub def nsDrawRoundedRectStroke(x: Float, y: Float, w: Float, h: Float, r: Float, lw: Float): Void = {
    let p = nsBezierRoundedRect(cgRect(x, y, w, h), r, r);
    nsBezierSetLineWidth(p, lw);
    nsBezierStroke(p)
}

// ---------------------------------------------------------------------------
// NSImage (vector drawing handler, SF Symbols, PNG export)
// ---------------------------------------------------------------------------

def imageDrawBlockInvoke(blk: Ptr, dstRect: CGRect): Bool = {
    let f: CGRect -> Bool = gcHandleGet(objcBlockHandle(blk));
    f(dstRect)
}

/// Create a vector `NSImage` using `+[NSImage imageWithSize:flipped:drawingHandler:]`.
pub def nsImageDraw(w: Float, h: Float, flipped: Bool, drawFn: CGRect -> Bool): Id NSObject = {
    let blk = objcBlockCustom(cFnPtr(imageDrawBlockInvoke), gcHandleNew(drawFn));
    let raw = withForeignPtr(blk, (bp) ->
        msgSend1Size1Bool1Ptr(objcClass("NSImage"), objcSel("imageWithSize:flipped:drawingHandler:"), cgSize(w, h), flipped, bp)
    );
    idRetain(raw)
}

pub def nsImageSetTemplate(img: Id NSObject, isTemplate: Bool): Void =
    withId(img, (p) -> {
        c_setT(p, objcSel("setTemplate:"), isTemplate)
    })

pub def nsImageSetAccessibilityDescription(img: Id NSObject, desc: String): Void = {
    let ns = nsString(desc);
    withId(img, (p) -> withId(ns, (dp) -> {
        c_setD(p, objcSel("setAccessibilityDescription:"), dp)
    }))
}

pub def nsImageSize(img: Id NSObject): CGSize =
    withId(img, (p) -> {
        c_sz(p, objcSel("size"))
    })

pub def nsImageSystemSymbol(name: String): Option (Id NSObject) = {
    let ns = nsString(name);
    let raw = withId(ns, (np) -> {
        c_sym(objcClass("NSImage"), objcSel("imageWithSystemSymbolName:accessibilityDescription:"), np, ptrNull())
    });
    idRetainOpt(raw)
}

pub def nsImageWithSymbolConfig(img: Id NSObject, pointSize: Float, weight: Float): Option (Id NSObject) = {
    let cfgCls = objcClass("NSImageSymbolConfiguration");
    if (ptrIsNull(cfgCls)) None
    else {
        let cfg = msgSend1Float1Float(cfgCls, objcSel("configurationWithPointSize:weight:"), pointSize, weight);
        if (ptrIsNull(cfg)) None
        else {
            let raw = withId(img, (ip) -> {
                c_wsc(ip, objcSel("imageWithSymbolConfiguration:"), cfg)
            });
            idRetainOpt(raw)
        }
    }
}

pub def nsImageDrawInRect(img: Id NSObject, dst: CGRect, op: Int64, fraction: Float): Void =
    withId(img, (ip) -> {
        c_draw(ip, objcSel("drawInRect:fromRect:operation:fraction:"), dst, cgRect(0.0, 0.0, 0.0, 0.0), op, fraction)
    })

// ---------------------------------------------------------------------------
// Text measurement & drawing (`NSString sizeWithAttributes:` / `drawAtPoint:withAttributes:`)
// ---------------------------------------------------------------------------

def makeFontAttrsDict(font: Ptr, colorOpt: Option Ptr): Ptr = {
    let d = msgSend0(objcClass("NSMutableDictionary"), objcSel("dictionary"));
    let kFont = resolveGlobalPtr("NSFontAttributeName");
    if (!ptrIsNull(kFont) && !ptrIsNull(font)) {
        msgSendVoid2Ptr(d, objcSel("setObject:forKey:"), font, kFont)
    } else ();
    match colorOpt {
        Some(c) -> {
            let kFg = resolveGlobalPtr("NSForegroundColorAttributeName");
            if (!ptrIsNull(kFg) && !ptrIsNull(c)) {
                msgSendVoid2Ptr(d, objcSel("setObject:forKey:"), c, kFg)
            } else ()
        },
        None -> (),
    };
    d
}

pub def nsTextMeasureSize(text: String, font: Ptr): CGSize = {
    let ns = nsString(text);
    let attrs = makeFontAttrsDict(font, None);
    withId(ns, (np) -> {
        c_szAttr(np, objcSel("sizeWithAttributes:"), attrs)
    })
}

pub def nsTextDrawAt(text: String, x: Float, y: Float, font: Ptr, color: Ptr): Void = {
    let ns = nsString(text);
    let attrs = makeFontAttrsDict(font, Some(color));
    withId(ns, (np) -> {
        c_drawAt(np, objcSel("drawAtPoint:withAttributes:"), cgPoint(x, y), attrs)
    })
}

// ---------------------------------------------------------------------------
// NSScreen helpers (AppKit bottom-left -> AX top-left coordinates)
// ---------------------------------------------------------------------------

/// Return `(screens, primaryTopY)` matching `Manager.screenSnapshots()`.
pub def collectScreenDescriptors(): (List ScreenSpec, Float) = {
    let cls = objcClass("NSScreen");
    let screens = msgSend0(cls, objcSel("screens"));
    let n = nsArrayCount(screens);
    if (n == 0) (Nil, 0.0)
    else {
        let first = nsArrayObjectAt(screens, 0);
        let firstFrame = msgSendRect0(first, objcSel("frame"));
        let primaryTop = firstFrame.origin.y + firstFrame.size.h;
        let rev: Cell (List ScreenSpec) = cellNew(Nil);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let idx = cellGet(i);
            let scr = nsArrayObjectAt(screens, idx);
            let full = msgSendRect0(scr, objcSel("frame"));
            let vis = msgSendRect0(scr, objcSel("visibleFrame"));
            let desc = msgSend0(scr, objcSel("deviceDescription"));
            let sid = match nsNumberIntOpt(nsDictGet(desc, "NSScreenNumber")) {
                Some(v) -> v,
                None -> idx,
            };
            // Convert AppKit bottom-left origin to AX top-left origin
            let fullAX = rectNew(full.origin.x, primaryTop - (full.origin.y + full.size.h), full.size.w, full.size.h);
            let visAX = rectNew(vis.origin.x, primaryTop - (vis.origin.y + vis.size.h), vis.size.w, vis.size.h);
            cellSet(rev, Cons(ScreenSpec {
                id: sid,
                fullFrame: fullAX,
                visibleFrame: visAX,
            }, cellGet(rev)));
            cellSet(i, idx + 1)
        };
        (listRev(cellGet(rev)), primaryTop)
    }
}

pub def nsScreenForId(screenId: Int): Ptr = {
    let screens = msgSend0(objcClass("NSScreen"), objcSel("screens"));
    let n = nsArrayCount(screens);
    let found = cellNew(ptrNull());
    let i = cellNew(0);
    while (cellGet(i) < n && ptrIsNull(cellGet(found))) {
        let idx = cellGet(i);
        let scr = nsArrayObjectAt(screens, idx);
        let desc = msgSend0(scr, objcSel("deviceDescription"));
        match nsNumberIntOpt(nsDictGet(desc, "NSScreenNumber")) {
            Some(v) if (v == screenId) -> cellSet(found, scr),
            _ -> (),
        };
        cellSet(i, idx + 1)
    };
    if (!ptrIsNull(cellGet(found))) cellGet(found)
    else msgSend0(objcClass("NSScreen"), objcSel("mainScreen"))
}

// ---------------------------------------------------------------------------
// NSApplication, NSEvent, Appearance, PNG Export
// ---------------------------------------------------------------------------

pub def nsAppShared(): Ptr = msgSend0(objcClass("NSApplication"), objcSel("sharedApplication"))

pub def nsEventMouseLocation(): CGPoint =
    msgSendPoint0(objcClass("NSEvent"), objcSel("mouseLocation"))

pub def nsAppearanceIsDark(viewOrApp: Ptr): Bool = {
    if (ptrIsNull(viewOrApp)) false
    else {
        let eff = msgSend0(viewOrApp, objcSel("effectiveAppearance"));
        if (ptrIsNull(eff)) false
        else {
            let namePtr = msgSend0(eff, objcSel("name"));
            let name = fromNSStringPtr(namePtr);
            name == "NSAppearanceNameDarkAqua"
                || name == "NSAppearanceNameVibrantDark"
                || name == "NSAppearanceNameAccessibilityHighContrastDarkAqua"
                || name == "NSAppearanceNameAccessibilityHighContrastVibrantDark"
        }
    }
}

/// Render an `NSView` to a high-DPI PNG file at `path` (used by `--render-previews`).
pub def nsViewWritePng(viewPtr: Ptr, path: String, scale: Float): Bool = {
    let bounds = msgSendRect0(viewPtr, objcSel("bounds"));
    let bw = bounds.size.w;
    let bh = bounds.size.h;
    let pw = floatToInt(bw * scale);
    let ph = floatToInt(bh * scale);
    if (pw <= 0 || ph <= 0) false
    else {
        // Allocate NSBitmapImageRep at Retina pixel dimensions
        let repCls = objcClass("NSBitmapImageRep");
        let repAlloc = msgSend0(repCls, objcSel("alloc"));
        let csName = nsString("NSCalibratedRGBColorSpace");
        let rep = withId(csName, (csp) ->
            c_initRep(
                repAlloc,
                objcSel("initWithBitmapDataPlanes:pixelsWide:pixelsHigh:bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:colorSpaceName:bytesPerRow:bitsPerPixel:"),
                ptrNull(), intToI64(pw), intToI64(ph), intToI64(8), intToI64(4),
                true, false, csp, intToI64(0), intToI64(0)
            )
        );
        if (ptrIsNull(rep)) false
        else {
            let repId = idAdopt(rep);
            // Set logical point size so cacheDisplayInRect renders at `scale`x Retina!
            withId(repId, (rp) -> {
                c_setSz(rp, objcSel("setSize:"), cgSize(bw, bh));
                c_cache(viewPtr, objcSel("cacheDisplayInRect:toBitmapImageRep:"), bounds, rp)
            });
            // representationUsingType:NSBitmapImageFileTypePNG(4) properties:@{}
            let emptyDict = msgSend0(objcClass("NSDictionary"), objcSel("dictionary"));
            let pngData = withId(repId, (rp) -> {
                c_repUsing(rp, objcSel("representationUsingType:properties:"), intToI64(4), emptyDict)
            });
            if (ptrIsNull(pngData)) false
            else {
                let nsPath = nsString(path);
                withId(nsPath, (pp) -> {
                    c_writeToFile(pngData, objcSel("writeToFile:atomically:"), pp, true)
                })
            }
        }
    }
}

/// Write an `NSImage` to a PNG file at `path` (e.g. for app icon generation or status preview export).
pub def nsImageWritePng(img: Id NSObject, path: String, pixelW: Int, pixelH: Int): Bool = {
    let repAlloc = msgSend0(objcClass("NSBitmapImageRep"), objcSel("alloc"));
    let csName = nsString("NSCalibratedRGBColorSpace");
    let rep = withId(csName, (csp) ->
        c_initRep2(
            repAlloc,
            objcSel("initWithBitmapDataPlanes:pixelsWide:pixelsHigh:bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:colorSpaceName:bytesPerRow:bitsPerPixel:"),
            ptrNull(), intToI64(pixelW), intToI64(pixelH), intToI64(8), intToI64(4),
            true, false, csp, intToI64(0), intToI64(0)
        )
    );
    if (ptrIsNull(rep)) false
    else {
        let repId = idAdopt(rep);
        let ctxCls = objcClass("NSGraphicsContext");
        msgSendVoid0(ctxCls, objcSel("saveGraphicsState"));
        let ctx = withId(repId, (rp) -> {
            c_ctxFromRep(ctxCls, objcSel("graphicsContextWithBitmapImageRep:"), rp)
        });
        msgSendVoid1Ptr(ctxCls, objcSel("setCurrentContext:"), ctx);
        nsImageDrawInRect(img, cgRect(0.0, 0.0, intToFloat(pixelW), intToFloat(pixelH)), kNSCompositingOperationSourceOver(), 1.0);
        msgSendVoid0(ctxCls, objcSel("restoreGraphicsState"));
        let emptyDict = msgSend0(objcClass("NSDictionary"), objcSel("dictionary"));
        let pngData = withId(repId, (rp) -> {
            c_repUsing2(rp, objcSel("representationUsingType:properties:"), intToI64(4), emptyDict)
        });
        if (ptrIsNull(pngData)) false
        else {
            let nsPath = nsString(path);
            withId(nsPath, (pp) -> {
                c_writeToFile2(pngData, objcSel("writeToFile:atomically:"), pp, true)
            })
        }
    }
}

// ---------------------------------------------------------------------------
// Target-action trampoline helper for AppKit controls & menus
// ---------------------------------------------------------------------------

def gActionAssocKey: Ptr = ptrAllocBytes(8)

def actionTargetInvoke(self: Ptr, _cmd: Ptr, sender: Ptr): Void = {
    let _ = _cmd;
    let h = objcGetAssocHandle(self, gActionAssocKey);
    if (h != intToI64(0)) {
        let cb: Ptr -> Void = gcHandleGet(h);
        cb(sender)
    } else ()
}

def ensureActionTargetClass(): Ptr = {
    let existing = objcClass("TalusActionTarget");
    if (!ptrIsNull(existing)) existing
    else {
        let cls = objcAllocateClass("NSObject", "TalusActionTarget");
        if (!ptrIsNull(cls)) {
            let _ = objcAddMethod(cls, "invoke:", cFnPtr(actionTargetInvoke), "v@:@");
            objcRegisterClass(cls)
        } else ();
        objcClass("TalusActionTarget")
    }
}

/// Create a GC-managed Objective-C target object whose `invoke:` selector runs `cb(sender)`.
pub def makeActionTarget(cb: Ptr -> Void): Id NSObject = {
    let cls = ensureActionTargetClass();
    let raw = msgSend0(msgSend0(cls, objcSel("alloc")), objcSel("init"));
    objcSetAssocHandle(raw, gActionAssocKey, gcHandleNew(cb));
    idAdopt(raw)
}

pub def actionTargetSel(): Ptr = objcSel("invoke:")

// ---------------------------------------------------------------------------
// TextField delegate helper (controlTextDidChange:)
// ---------------------------------------------------------------------------

def gTextDelegateAssocKey: Ptr = ptrAllocBytes(8)

def textDelegateDidChange(self: Ptr, _cmd: Ptr, notif: Ptr): Void = {
    let _ = _cmd;
    let h = objcGetAssocHandle(self, gTextDelegateAssocKey);
    if (h != intToI64(0)) {
        let cb: Ptr -> Void = gcHandleGet(h);
        let obj = msgSend0(notif, objcSel("object"));
        cb(obj)
    } else ()
}

def ensureTextDelegateClass(): Ptr = {
    let existing = objcClass("TalusTextFieldDelegate");
    if (!ptrIsNull(existing)) existing
    else {
        let cls = objcAllocateClass("NSObject", "TalusTextFieldDelegate");
        if (!ptrIsNull(cls)) {
            let _ = objcAddMethod(cls, "controlTextDidChange:", cFnPtr(textDelegateDidChange), "v@:@");
            objcRegisterClass(cls)
        } else ();
        objcClass("TalusTextFieldDelegate")
    }
}

