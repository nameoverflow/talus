}

pub def imageViewSetImage(iv: Ptr, img: Id NSObject): Void =
    withId(img, (ip) -> {
        c_setImg2(iv, objcSel("setImage:"), ip)
    })

pub def makeMenuItem(title: String, keyEquiv: String, targetOpt: Option (Id NSObject)): Id NSObject = {
    let tNs = nsString(title);
    let kNs = nsString(keyEquiv);
    let alloc = msgSend0(objcClass("NSMenuItem"), objcSel("alloc"));
    let act = match targetOpt { Some(_) -> actionTargetSel(), None -> ptrNull() };
    let raw = withId(tNs, (tp) -> withId(kNs, (kp) -> {
        c_mi(alloc, objcSel("initWithTitle:action:keyEquivalent:"), tp, act, kp)
    }));
    let id = idAdopt(raw);
    match targetOpt {
        Some(tg) -> withId(tg, (tgp) -> {
            c_setTgt3(raw, objcSel("setTarget:"), tgp)
        }),
        None -> (),
    };
    id
}

pub def makeMenuItemWithSelector(title: String, keyEquiv: String, selName: String): Id NSObject = {
    let tNs = nsString(title);
    let kNs = nsString(keyEquiv);
    let alloc = msgSend0(objcClass("NSMenuItem"), objcSel("alloc"));
    let raw = withId(tNs, (tp) -> withId(kNs, (kp) -> {
        c_mi2(alloc, objcSel("initWithTitle:action:keyEquivalent:"), tp, objcSel(selName), kp)
    }));
    idAdopt(raw)
}

pub def nsMenuAddItem(menu: Ptr, item: Id NSObject): Void =
