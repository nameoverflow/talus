// Utility to read Foundation collection values safely on raw Ptr (borrowed)
pub def nsArrayCount(arrPtr: Ptr): Int =
    if (ptrIsNull(arrPtr)) 0 else i64ToInt(msgSendI64_0(arrPtr, objcSel("count")))

pub def nsArrayObjectAt(arrPtr: Ptr, idx: Int): Ptr =
    msgSend1I64(arrPtr, objcSel("objectAtIndex:"), intToI64(idx))

pub def nsDictObjectForKey(dictPtr: Ptr, key: String): Ptr =
    if (ptrIsNull(dictPtr)) ptrNull()
    else withId(nsString(key), (kp) -> msgSend1Ptr(dictPtr, objcSel("objectForKey:"), ptrFromAddrI64(intToI64(0))))

// Clean dict lookup taking ScopedPtr key via extern objc_msgSend
extern "objc_msgSend" def c_msgSend1Scoped(obj: Ptr, sel: Ptr, a0: ScopedPtr): Ptr
extern "objc_msgSend" def c_msgSendVoid2Scoped(obj: Ptr, sel: Ptr, a0: ScopedPtr, a1: ScopedPtr): Void
extern "objc_msgSend" def c_msgSendVoid1Scoped(obj: Ptr, sel: Ptr, a0: ScopedPtr): Void

pub def nsDictGet(dictPtr: Ptr, key: String): Ptr =
    if (ptrIsNull(dictPtr)) ptrNull()
    else withId(nsString(key), (kp) -> c_msgSend1Scoped(dictPtr, objcSel("objectForKey:"), kp))

pub def nsDictGetPtrKey(dictPtr: Ptr, keyPtr: Ptr): Ptr =
    if (ptrIsNull(dictPtr) || ptrIsNull(keyPtr)) ptrNull()
    else msgSend1Ptr(dictPtr, objcSel("objectForKey:"), keyPtr)

pub def nsObjectIsKindOf(objPtr: Ptr, className: String): Bool =
    if (ptrIsNull(objPtr)) false
    else {
        let cls = objcClass(className);
        if (ptrIsNull(cls)) false
        else msgSendBool1Ptr(objPtr, objcSel("isKindOfClass:"), cls)
    }

pub def nsNumberIntOpt(objPtr: Ptr): Option Int =
    if (nsObjectIsKindOf(objPtr, "NSNumber")) Some(msgSendInt0(objPtr, objcSel("intValue")))
    else None

pub def nsNumberI64Opt(objPtr: Ptr): Option Int64 =
    if (nsObjectIsKindOf(objPtr, "NSNumber")) Some(msgSendI64_0(objPtr, objcSel("longLongValue")))
    else None

pub def nsNumberFloatOpt(objPtr: Ptr): Option Float =
    if (nsObjectIsKindOf(objPtr, "NSNumber")) Some(msgSendFloat0(objPtr, objcSel("doubleValue")))
    else None

pub def nsStringOpt(objPtr: Ptr): Option String =
    if (nsObjectIsKindOf(objPtr, "NSString")) Some(fromNSStringPtr(objPtr))
    else None
