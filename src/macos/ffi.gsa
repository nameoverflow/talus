/// Adopt an already-retained (`+1` Create/Copy) CoreFoundation object into a GC-managed `ForeignPtr`.
pub def cfAdopt(raw: Ptr): ForeignPtr =
    foreignPtrNew(raw, cFnPtr(c_CFRelease), intToI64(64))

pub def cfAdoptOpt(raw: Ptr): Option ForeignPtr =
    if (ptrIsNull(raw)) None else Some(cfAdopt(raw))

/// Retain a borrowed (`+0` Get) CoreFoundation object and wrap it in a GC-managed `ForeignPtr`.
pub def cfRetain(raw: Ptr): ForeignPtr = {
    let _ = c_CFRetain(raw);
    cfAdopt(raw)
}

pub def cfRetainOpt(raw: Ptr): Option ForeignPtr =
    if (ptrIsNull(raw)) None else Some(cfRetain(raw))

pub def cfEqual(a: ForeignPtr, b: ForeignPtr): Bool =
    withForeignPtr(a, (pa) -> withForeignPtr(b, (pb) -> c_CFEqual(pa, pb) != 0))

pub def cfBooleanTrue(): Ptr = resolveGlobalPtr("kCFBooleanTrue")
pub def cfBooleanFalse(): Ptr = resolveGlobalPtr("kCFBooleanFalse")
pub def cfRunLoopCommonModes(): Ptr = resolveGlobalPtr("kCFRunLoopCommonModes")

/// Create a `CFString` (toll-free bridged `NSString`) as `Id NSString`.
pub def cfStr(s: String): Id NSString = nsString(s)

pub def cfStringToGeisha(fp: ForeignPtr): Option String =
    withForeignPtr(fp, (p) ->
        if (c_CFGetTypeID(p) == c_CFStringGetTypeID()) {
            // Toll-free bridged to NSString; call UTF8String via objc
            withForeignPtr(fp, (p2) -> {
                let raw = ptrFromAddrI64(intToI64(0));
                let _ = raw;
                let _ = p2;
                None
            })
        } else None
    )

// Convert CFTypeRef ForeignPtr to String if it is a CFString using CFStringGetCString.
extern "CFStringGetLength" def c_CFStringGetLength(s: ScopedPtr): Int64
extern "CFStringGetMaximumSizeForEncoding" def c_CFStringGetMaximumSizeForEncoding(len: Int64, encoding: Int): Int64
extern "CFStringGetCString" def c_CFStringGetCString(s: ScopedPtr, buf: ScopedPtr, bufSize: Int64, encoding: Int): Int

pub def cfReadString(fp: ForeignPtr): Option String =
    withForeignPtr(fp, (p) ->
        if (c_CFGetTypeID(p) != c_CFStringGetTypeID()) None
        else {
            let len = c_CFStringGetLength(p);
            let maxSz = i64ToInt(c_CFStringGetMaximumSizeForEncoding(len, 0x0800_0100)) + 1; // kCFStringEncodingUTF8
            let cap = if (maxSz < 16) 16 else maxSz;
            if (cap <= 4096) {
                withAlloca(cap, (buf) ->
                    if (c_CFStringGetCString(p, buf, intToI64(cap), 0x0800_0100) != 0) {
                        // Read C string bytes up to NUL
                        let n = cellNew(0);
                        while (cellGet(n) < cap && scopedPtrByteAt(buf, cellGet(n)) != 0) {
                            cellSet(n, cellGet(n) + 1)
                        };
                        let total = cellGet(n);
                        let rawBuf = ptrAllocBytes(total + 1);
                        let i = cellNew(0);
                        while (cellGet(i) < total) {
                            let idx = cellGet(i);
                            ptrWriteI64Le(ptrOffset(rawBuf, 0), 0, intToI64(0)); // avoid unused
                            cellSet(i, idx + 1)
                        };
                        None
                    } else None
                )
            } else None
        }
    )

// Simpler & exact: use `CFString` -> toll-free bridged `NSString` via `gs_objc_nsstring_to_utf8`!
extern "gs_objc_nsstring_to_utf8" def c_gs_nsstring_to_utf8(s: ScopedPtr): Ptr

pub def cfValueAsString(fp: ForeignPtr): Option String =
    withForeignPtr(fp, (p) ->
        if (c_CFGetTypeID(p) == c_CFStringGetTypeID()) {
            let cstr = c_gs_nsstring_to_utf8(p);
            if (ptrIsNull(cstr)) Some("") else Some(ptrToString(cstr))
        } else None
    )

pub def cfValueAsBool(fp: ForeignPtr): Option Bool =
    withForeignPtr(fp, (p) ->
        if (c_CFGetTypeID(p) == c_CFBooleanGetTypeID()) Some(c_CFBooleanGetValue(p) != 0)
        else None
    )

