/// Low-level macOS C/CF/CG/AX/Carbon/Dispatch/POSIX FFI declarations and safe RAII helpers.
///
/// All `ForeignPtr` handles bind `CFRelease` directly via `foreignPtrNew`.
/// Neither `Ptr` nor `ForeignPtr` is `Send`; cross-thread work lives inside per-PID Actors.

use std.option.{Option, Some, None}
use sys.ffi.{dlOpen, dlSym}
use objc.{
    objcClass, objcSel, idRetain, idAdopt, idRetainOpt, idAdoptOpt,
    withId, nsString, fromNSString, fromNSStringPtr,
    msgSend0, msgSend1Ptr, msgSend2Ptr, msgSend1Int, msgSend1I64, msgSend1Bool,
    msgSendVoid0, msgSendVoid1Ptr, msgSendVoid2Ptr, msgSendVoid1Int, msgSendVoid1Bool,
    msgSendBool0, msgSendInt0, msgSendI64_0, msgSendFloat0,
    Id, NSString
}
use layout.{Rect, rectNew}

// ---------------------------------------------------------------------------
// C ABI value structs
// ---------------------------------------------------------------------------

pub extern data CGPoint { x: Float, y: Float }
pub extern data CGSize { w: Float, h: Float }
pub extern data CGRect { origin: CGPoint, size: CGSize }

pub extern data ProcessSerialNumber { highLongOfPSN: Int, lowLongOfPSN: Int }
pub extern data EventTypeSpec { eventClass: Int, eventKind: Int }
pub extern data EventHotKeyID { signature: Int, id: Int }

pub def cgPoint(x: Float, y: Float): CGPoint = CGPoint { x: x, y: y }
pub def cgSize(w: Float, h: Float): CGSize = CGSize { w: w, h: h }
pub def cgRect(x: Float, y: Float, w: Float, h: Float): CGRect =
    CGRect { origin: CGPoint { x: x, y: y }, size: CGSize { w: w, h: h } }

pub def rectToCG(r: Rect): CGRect = cgRect(r.x, r.y, r.w, r.h)
pub def cgToRect(r: CGRect): Rect = rectNew(r.origin.x, r.origin.y, r.size.w, r.size.h)

// ---------------------------------------------------------------------------
// Pointer helpers (only for C out-parameters / reading global C symbols)
// ---------------------------------------------------------------------------

pub def ptrFromAddrI64(addr: Int64): Ptr = ptrOffset64(ptrNull(), addr)

pub def readPtrAt(p: ScopedPtr, byteOffset: Int): Ptr =
    ptrFromAddrI64(scopedPtrReadI64Le(p, intToI64(byteOffset)))

pub def readRawPtrAt(p: Ptr, byteOffset: Int): Ptr =
    ptrFromAddrI64(ptrReadI64Le(p, byteOffset))

/// Resolve an exported global `const void *` symbol (e.g. `kCFBooleanTrue`, `NSFontAttributeName`).
pub def resolveGlobalPtr(symbol: String): Ptr =
    match dlSym(ptrNull(), symbol) {
        Some(symAddr) -> if (ptrIsNull(symAddr)) ptrNull() else readRawPtrAt(symAddr, 0),
        None -> ptrNull(),
    }

/// Resolve an exported global struct address (e.g. `_dispatch_main_q`) without dereferencing.
pub def resolveGlobalAddr(symbol: String): Ptr =
    match dlSym(ptrNull(), symbol) {
        Some(symAddr) -> symAddr,
        None -> ptrNull(),
    }

