pub def axIsProcessTrusted(): Bool = c_AXIsProcessTrusted() != 0

pub def axIsProcessTrustedWithPrompt(prompt: Bool): Bool = {
    let key = resolveGlobalPtr("kAXTrustedCheckOptionPrompt");
    let val = if (prompt) cfBooleanTrue() else cfBooleanFalse();
    if (!ptrIsNull(key) && !ptrIsNull(val)) {
        let nd = msgSend2Ptr(objcClass("NSDictionary"), objcSel("dictionaryWithObject:forKey:"), val, key);
        c_AXIsProcessTrustedWithOptions(nd) != 0
    } else c_AXIsProcessTrusted() != 0
}

pub def axCreateApplication(pid: Int): ForeignPtr = {
    let raw = c_AXUIElementCreateApplication(pid);
    let fp = cfAdopt(raw);
    let _ = withForeignPtr(fp, (p) -> c_AXUIElementSetMessagingTimeout(p, floatToF32(0.1)));
    fp
}

