def pickAppBundleId(): Option String = {
    let panel = msgSend0(objcClass("NSOpenPanel"), objcSel("openPanel"));
    let tNs = nsString("选择应用程序");
    withId(tNs, (tp) -> {
        c_setTitleP(panel, objcSel("setTitle:"), tp)
    });
    msgSendVoid1Bool(panel, objcSel("setAllowsMultipleSelection:"), false);
    msgSendVoid1Bool(panel, objcSel("setCanChooseDirectories:"), false);
    msgSendVoid1Bool(panel, objcSel("setCanChooseFiles:"), true);
    let appsDir = nsString("/Applications");
    let dirUrl = withId(appsDir, (ap) -> {
        c_fileUrl(objcClass("NSURL"), objcSel("fileURLWithPath:"), ap)
    });
    if (!ptrIsNull(dirUrl)) msgSendVoid1Ptr(panel, objcSel("setDirectoryURL:"), dirUrl) else ();
    let res = i64ToInt(msgSendI64_0(panel, objcSel("runModal")));
    if (res != 1) None
    else {
        let url = msgSend0(panel, objcSel("URL"));
        if (ptrIsNull(url)) None
        else {
            let bundle = msgSend1Ptr(objcClass("NSBundle"), objcSel("bundleWithURL:"), url);
            if (ptrIsNull(bundle)) None
            else {
                let bid = fromNSStringPtr(msgSend0(bundle, objcSel("bundleIdentifier")));
                if (strLen(bid) > 0) Some(bid) else None
            }
        }
    }
}

def pickExecutableFile(): Option String = {
    let panel = msgSend0(objcClass("NSOpenPanel"), objcSel("openPanel"));
    let tNs = nsString("选择可执行文件或脚本");
    withId(tNs, (tp) -> {
        c_setTitleP2(panel, objcSel("setTitle:"), tp)
    });
    msgSendVoid1Bool(panel, objcSel("setAllowsMultipleSelection:"), false);
    msgSendVoid1Bool(panel, objcSel("setCanChooseDirectories:"), false);
    msgSendVoid1Bool(panel, objcSel("setCanChooseFiles:"), true);
    msgSendVoid1Bool(panel, objcSel("setShowsHiddenFiles:"), true);
    let res = i64ToInt(msgSendI64_0(panel, objcSel("runModal")));
    if (res != 1) None
    else {
        let url = msgSend0(panel, objcSel("URL"));
        if (ptrIsNull(url)) None
        else {
            let p = fromNSStringPtr(msgSend0(url, objcSel("path")));
            if (strLen(p) > 0) Some(p) else None
        }
    }
}

// Keep strong references to targets/delegates/views owned by the current rendered tab
data UIRetainBag {
    UIRetainBag {
        items: Cell (List (Id NSObject)),
    }
}

def retainBagNew(): UIRetainBag = UIRetainBag { items: cellNew(Nil) }

extern "objc_msgSend" def c_objcSelf(p: ScopedPtr, sel: Ptr): Ptr

def idPtrKept(bag: UIRetainBag, obj: Id NSObject): Ptr = {
    cellSet(bag.items, Cons(obj, cellGet(bag.items)));
    withId(obj, (p) -> c_objcSelf(p, objcSel("self")))
}

/// Create a rounded section card (`SectionCard`) inside `parent` at `y` with given `height`, returning `(cardPtr, innerYStart)`.
def addSectionCard(
    bag: UIRetainBag,
    parent: Ptr,
    title: String,
    subtitle: String,
    x: Float,
    y: Float,
    w: Float,
    h: Float,
    dark: Bool
): (Ptr, Float) = {
    let cardId = makeFlippedView(cgRect(x, y, w, h));
    let card = idPtrKept(bag, cardId);
    let bg = if (dark) nsColorSRGB(1.0, 1.0, 1.0, 0.055) else nsColorSRGB(0.0, 0.0, 0.0, 0.032);
    let border = if (dark) nsColorSRGB(1.0, 1.0, 1.0, 0.11) else nsColorSRGB(0.0, 0.0, 0.0, 0.09);
    nsViewSetLayerStyle(card, Some(bg), Some(border), 1.0, 11.0);
    nsViewAddSubview(parent, card);

    let titleLbl = idPtrKept(bag, makeLabel(title, cgRect(14.0, 12.0, w - 28.0, 18.0), nsFontSystem(13.0, kFontWeightSemibold()), nsColorLabel()));
    nsViewAddSubview(card, titleLbl);

    let bodyY = if (strLen(subtitle) > 0) {
        let subLbl = idPtrKept(bag, makeLabel(subtitle, cgRect(14.0, 31.0, w - 28.0, 16.0), nsFontSystem(11.5, kFontWeightRegular()), nsColorSecondaryLabel()));
        nsViewAddSubview(card, subLbl);
        54.0
    } else 38.0;
    (card, bodyY)
}

def makeTilingPreviewView(bag: UIRetainBag, vm: SettingsViewModel, frame: CGRect, dark: Bool): Ptr = {
    let ratio = minFloat(0.8, maxFloat(0.2, cellGet(vm.masterRatioPercent) / 100.0));
    let masters = minInt(20, maxInt(1, cellGet(vm.masterCount)));
    let oGap = minFloat(64.0, maxFloat(0.0, cellGet(vm.outerGap))) * 0.45;
    let iGap = minFloat(64.0, maxFloat(0.0, cellGet(vm.innerGap))) * 0.45;
    let viewId = makeCustomDrawView(frame, (selfPtr: Ptr, _dirty: CGRect) -> {
        let bounds = msgSendRect0(selfPtr, objcSel("bounds"));
        let w = bounds.size.w;
        let h = bounds.size.h;
        // Desktop backdrop
        let bg = if (dark) nsColorSRGB(0.11, 0.13, 0.16, 1.0) else nsColorSRGB(0.88, 0.91, 0.94, 1.0);
        nsColorSetFill(bg);
        nsDrawRoundedRectFill(0.0, 0.0, w, h, 10.0);
        // Subtle simulated menu bar strip at top (AppKit non-flipped y = h - 16)
        let mbH = 16.0;
        let mb = if (dark) nsColorSRGB(0.17, 0.19, 0.23, 0.95) else nsColorSRGB(0.96, 0.97, 0.98, 0.95);
        nsColorSetFill(mb);
        nsDrawRoundedRectFill(1.0, h - mbH - 1.0, w - 2.0, mbH, 4.0);

        let usableH = h - mbH - 12.0;
        let area = rectNew(6.0, 6.0, w - 12.0, usableH);
        let rects = tallLayoutWithGaps(area, 4, masters, ratio, oGap, iGap);
        let idx = cellNew(0);
        let cr = cellNew(rects);
        while (match cellGet(cr) { Nil -> false, _ -> true }) {
            match cellGet(cr) {
                Cons(r, rest) -> {
                    let i = cellGet(idx);
                    let isMaster = i < masters;
                    let fill = if (isMaster) {
                        if (dark) nsColorSRGB(0.06, 0.46, 0.43, 0.88) else nsColorSRGB(0.08, 0.56, 0.52, 0.84)
                    } else {
                        if (dark) nsColorSRGB(0.24, 0.28, 0.34, 0.90) else nsColorSRGB(0.99, 0.99, 1.0, 0.94)
                    };
                    let stroke = if (isMaster) {
                        nsColorSRGB(0.18, 0.83, 0.75, 0.72)
                    } else {
                        if (dark) nsColorSRGB(1.0, 1.0, 1.0, 0.16) else nsColorSRGB(0.0, 0.0, 0.0, 0.14)
                    };
                    // Convert top-down rect `r` inside `area` to bottom-up AppKit coordinates below menu bar
                    let topOfWork = h - mbH - 6.0;
                    let drawY = topOfWork - (r.y - 6.0) - r.h;
                    let drawW = maxFloat(8.0, r.w);
                    let drawH = maxFloat(8.0, r.h);
                    nsColorSetFill(fill);
                    nsDrawRoundedRectFill(r.x, drawY, drawW, drawH, 6.0);
                    nsColorSetStroke(stroke);
                    nsDrawRoundedRectStroke(r.x + 0.5, drawY + 0.5, maxFloat(7.0, drawW - 1.0), maxFloat(7.0, drawH - 1.0), 6.0, 1.0);
                    let lbl = if (isMaster) "主区 " + intToStr(i + 1) else "副区 " + intToStr(i + 1);
                    let txtCol = if (isMaster || dark) nsColorWithAlpha(nsColorWhite(), 0.92) else nsColorSRGB(0.15, 0.18, 0.22, 0.92);
                    nsTextDrawAt(lbl, r.x + 8.0, drawY + maxFloat(4.0, drawH - 18.0), nsFontSystem(10.5, kFontWeightSemibold()), txtCol);
                    cellSet(idx, i + 1);
                    cellSet(cr, rest)
                },
                Nil -> (),
            }
        }
    });
    idPtrKept(bag, viewId)
}

