pub data SettingsWindowController {
    SettingsWindowController {
        viewModel: SettingsViewModel,
        window: Cell (Option (Id NSObject)),
        tabSegment: Cell Ptr,
        scrollView: Cell Ptr,
        bannerLabel: Cell Ptr,
        validationLabel: Cell Ptr,
        bag: UIRetainBag,
        chromeBag: UIRetainBag,
        onClose: Cell (Option (() -> Void)),
        isPreviewMode: Cell Bool,
    }
}

def installEditMenuIfNeeded(): Void = {
    let app = nsAppShared();
    let existing = msgSend0(app, objcSel("mainMenu"));
    if (ptrIsNull(existing)) {
        let mainMenu = msgSend0(msgSend0(objcClass("NSMenu"), objcSel("alloc")), objcSel("init"));
        let appItem = msgSend0(msgSend0(objcClass("NSMenuItem"), objcSel("alloc")), objcSel("init"));
        let appSub = msgSend0(msgSend0(objcClass("NSMenu"), objcSel("alloc")), objcSel("init"));
        nsMenuAddItem(appSub, makeMenuItemWithSelector("关闭窗口", "w", "performClose:"));
        nsMenuAddSeparator(appSub);
        nsMenuAddItem(appSub, makeMenuItemWithSelector("退出 Talus", "q", "terminate:"));
        msgSendVoid1Ptr(appItem, objcSel("setSubmenu:"), appSub);
        msgSendVoid1Ptr(mainMenu, objcSel("addItem:"), appItem);

        let editItem = msgSend0(msgSend0(objcClass("NSMenuItem"), objcSel("alloc")), objcSel("init"));
        let editTitle = nsString("编辑");
        let editSub = withId(editTitle, (ep) -> {
            c_menuInit(msgSend0(objcClass("NSMenu"), objcSel("alloc")), objcSel("initWithTitle:"), ep)
        });
        nsMenuAddItem(editSub, makeMenuItemWithSelector("撤销", "z", "undo:"));
        nsMenuAddItem(editSub, makeMenuItemWithSelector("重做", "Z", "redo:"));
        nsMenuAddSeparator(editSub);
        nsMenuAddItem(editSub, makeMenuItemWithSelector("剪切", "x", "cut:"));
        nsMenuAddItem(editSub, makeMenuItemWithSelector("拷贝", "c", "copy:"));
        nsMenuAddItem(editSub, makeMenuItemWithSelector("粘贴", "v", "paste:"));
        nsMenuAddItem(editSub, makeMenuItemWithSelector("全选", "a", "selectAll:"));
        msgSendVoid1Ptr(editItem, objcSel("setSubmenu:"), editSub);
        msgSendVoid1Ptr(mainMenu, objcSel("addItem:"), editItem);

        msgSendVoid1Ptr(app, objcSel("setMainMenu:"), mainMenu)
    } else ()
}

def updateBannerLabels(ctrl: SettingsWindowController): Void = {
    let bPtr = cellGet(ctrl.bannerLabel);
    let vPtr = cellGet(ctrl.validationLabel);
    if (!ptrIsNull(bPtr)) {
        textFieldSetStringValue(bPtr, cellGet(ctrl.viewModel.statusBanner))
    } else ();
    if (!ptrIsNull(vPtr)) {
        match cellGet(ctrl.viewModel.validationMessage) {
            Some(err) -> {
                textFieldSetStringValue(vPtr, "⚠ " + err);
                msgSendVoid1Bool(vPtr, objcSel("setHidden:"), false)
            },
            None -> {
                textFieldSetStringValue(vPtr, "");
                msgSendVoid1Bool(vPtr, objcSel("setHidden:"), true)
            },
        }
    } else ()
}

// Forward-ish tab builders (in dependency order before rebuildActiveTab)

def buildGeneralTab(ctrl: SettingsWindowController, bag: UIRetainBag, width: Float, dark: Bool, rebuild: () -> Void): Id NSObject = {
    let vm = ctrl.viewModel;
    let contentW = width - 36.0;
    let docId = makeFlippedView(cgRect(0.0, 0.0, width, 540.0));
    let doc = idPtrKept(bag, docId);
    let y = cellNew(14.0);

    // Card 1: 工作区模式与数量
    let isVirt = cellGet(vm.workspaceMode) == "virtual";
    let card1H = if (isVirt) 152.0 else 112.0;
    let (c1, cy1) = addSectionCard(bag, doc, "工作区模式", "选择虚拟工作区（瞬时切换、按应用自动归位）或跟随 macOS 原生 Spaces", 18.0, cellGet(y), contentW, card1H, dark);
    let modeTgt = makeActionTarget((sender) -> {
        let seg = i64ToInt(msgSendI64_0(sender, objcSel("selectedSegment")));
        cellSet(vm.workspaceMode, if (seg == 0) "virtual" else "native");
        vmNotifyChanged(vm, true);
        rebuild()
    });
    let _ = idPtrKept(bag, modeTgt);
    let modeSeg = idPtrKept(bag, makeSegmentedControl(["虚拟工作区（推荐）", "macOS 原生桌面"], if (isVirt) 0 else 1, cgRect(14.0, cy1, 320.0, 26.0), modeTgt));
    nsViewAddSubview(c1, modeSeg);

    if (isVirt) {
        let cntLbl = idPtrKept(bag, makeLabel("工作区数量：" + intToStr(cellGet(vm.workspaceCount)) + " 个（" + vmModifierSymbolPrefix(vm) + "1–" + intToStr(cellGet(vm.workspaceCount)) + " 切换）", cgRect(14.0, cy1 + 40.0, 310.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel()));
        nsViewAddSubview(c1, cntLbl);
        let cntItems = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];
        let cntTgt = makeActionTarget((sender) -> {
            let idx = i64ToInt(msgSendI64_0(sender, objcSel("indexOfSelectedItem")));
            cellSet(vm.workspaceCount, idx + 1);
            vmNotifyChanged(vm, true);
            rebuild()
        });
        let _ = idPtrKept(bag, cntTgt);
        let cntPop = idPtrKept(bag, makePopUpButton(cntItems, cellGet(vm.workspaceCount) - 1, cgRect(contentW - 96.0, cy1 + 35.0, 82.0, 26.0), cntTgt));
        nsViewAddSubview(c1, cntPop)
    } else ();
    cellSet(y, cellGet(y) + card1H + 14.0);

    // Card 2: 开机自动启动 (SMAppService.mainApp)
    let needsApp = launchAtLoginNeedsApproval(vm.launchAtLogin);
    let loginErr = launchAtLoginError(vm.launchAtLogin);
    let card2H = if (needsApp || (match loginErr { Some(_) -> true, None -> false })) 130.0 else 96.0;
    let (c2, cy2) = addSectionCard(bag, doc, "启动与系统集成", "由 macOS 登录项管理（不写入 TOML 配置文件）", 18.0, cellGet(y), contentW, card2H, dark);
    let lLbl = idPtrKept(bag, makeLabel("登录 macOS 时自动启动 Talus", cgRect(14.0, cy2 + 4.0, 260.0, 18.0), nsFontSystem(12.5, kFontWeightMedium()), nsColorLabel()));
    nsViewAddSubview(c2, lLbl);
    let loginTgt = makeActionTarget((sender) -> {
        launchAtLoginSetEnabled(vm.launchAtLogin, controlStateOn(sender));
        rebuild()
    });
    let _ = idPtrKept(bag, loginTgt);
    let sw = idPtrKept(bag, makeSwitch(launchAtLoginIsEnabled(vm.launchAtLogin), cgRect(contentW - 58.0, cy2, 42.0, 24.0), loginTgt));
    nsViewAddSubview(c2, sw);

    if (needsApp) {
        let appNote = idPtrKept(bag, makeLabel("需要在系统设置 → 登录项中批准 Talus", cgRect(14.0, cy2 + 34.0, 320.0, 18.0), nsFontSystem(11.5, kFontWeightRegular()), nsColorSystemOrange()));
        nsViewAddSubview(c2, appNote);
        let openTgt = makeActionTarget((_) -> launchAtLoginOpenSettings(vm.launchAtLogin));
        let _ = idPtrKept(bag, openTgt);
        let openBtn = idPtrKept(bag, makePushButton("打开登录项设置…", cgRect(contentW - 144.0, cy2 + 29.0, 130.0, 26.0), openTgt));
        nsViewAddSubview(c2, openBtn)
    } else match loginErr {
        Some(em) -> {
            let errLbl = idPtrKept(bag, makeLabel(em, cgRect(14.0, cy2 + 34.0, contentW - 28.0, 18.0), nsFontSystem(11.5, kFontWeightRegular()), nsColorSystemRed()));
            nsViewAddSubview(c2, errLbl)
        },
        None -> (),
    };
    cellSet(y, cellGet(y) + card2H + 14.0);

    // Card 3: 配置文件与快捷操作
    let card3H = 112.0;
    let (c3, cy3) = addSectionCard(bag, doc, "配置文件", "所有设置均通过保注释 TOML 写回磁盘，手写注释不会丢失", 18.0, cellGet(y), contentW, card3H, dark);
    let pathLbl = idPtrKept(bag, makeLabel("当前路径：" + abbreviatedPath(cellGet(vm.savePath)), cgRect(14.0, cy3 + 4.0, contentW - 140.0, 18.0), nsFontMonospaced(11.5, kFontWeightRegular()), nsColorSecondaryLabel()));
    nsViewAddSubview(c3, pathLbl);
    let resetTgt = makeActionTarget((_) -> {
        let p = cellGet(vm.savePath);
        vmReloadFromExternal(vm, defaultConfig(), ConfigResolution { loadPath: p, savePath: p, migratedFromJson: false });
        vmNotifyChanged(vm, true);
        rebuild()
    });
    let _ = idPtrKept(bag, resetTgt);
    let resetBtn = idPtrKept(bag, makePushButton("恢复默认设置", cgRect(contentW - 122.0, cy3 - 1.0, 108.0, 26.0), resetTgt));
    nsViewAddSubview(c3, resetBtn);

    cellSet(y, cellGet(y) + card3H + 18.0);
    msgSendVoid1Rect(doc, objcSel("setFrame:"), cgRect(0.0, 0.0, width, maxFloat(460.0, cellGet(y))));
    docId
}

def buildLayoutTab(ctrl: SettingsWindowController, bag: UIRetainBag, width: Float, dark: Bool, rebuild: () -> Void): Id NSObject = {
    let vm = ctrl.viewModel;
    let contentW = width - 36.0;
    let docId = makeFlippedView(cgRect(0.0, 0.0, width, 680.0));
    let doc = idPtrKept(bag, docId);
    let y = cellNew(14.0);

    // Card 1: 快捷键修饰键 + 常用键位速查
    let card1H = 166.0;
    let (c1, cy1) = addSectionCard(bag, doc, "全局快捷键修饰键", "至少保留一个修饰键；组合键与 Shift 变体自动注册", 18.0, cellGet(y), contentW, card1H, dark);
    let mods = cellGet(vm.modifiers);
    let cTgt = makeActionTarget((_) -> { vmToggleModifier(vm, "control"); rebuild() });
    let oTgt = makeActionTarget((_) -> { vmToggleModifier(vm, "option"); rebuild() });
    let mTgt = makeActionTarget((_) -> { vmToggleModifier(vm, "command"); rebuild() });
    let _ = idPtrKept(bag, cTgt);
    let _ = idPtrKept(bag, oTgt);
    let _ = idPtrKept(bag, mTgt);
    nsViewAddSubview(c1, idPtrKept(bag, makeCheckbox("⌃ Control", listContainsBy(mods, "control", eqStr), cgRect(14.0, cy1, 100.0, 22.0), cTgt)));
    nsViewAddSubview(c1, idPtrKept(bag, makeCheckbox("⌥ Option", listContainsBy(mods, "option", eqStr), cgRect(122.0, cy1, 100.0, 22.0), oTgt)));
    nsViewAddSubview(c1, idPtrKept(bag, makeCheckbox("⌘ Command", listContainsBy(mods, "command", eqStr), cgRect(230.0, cy1, 110.0, 22.0), mTgt)));

    let pfx = vmModifierSymbolPrefix(vm);
    let cheat1 = pfx + "J / K 切换焦点    " + pfx + "⇧J / ⇧K 交换顺序    " + pfx + "Return 置为主窗    " + pfx + "Space 切换布局";
    let cheat2 = pfx + "H / L 调整主区比例    " + pfx + ", / . 增减主区窗口    " + pfx + "T 浮动/平铺    " + pfx + "P 暂停";
    nsViewAddSubview(c1, idPtrKept(bag, makeLabel(cheat1, cgRect(14.0, cy1 + 36.0, contentW - 28.0, 18.0), nsFontMonospaced(11.0, kFontWeightRegular()), nsColorSecondaryLabel())));
    nsViewAddSubview(c1, idPtrKept(bag, makeLabel(cheat2, cgRect(14.0, cy1 + 58.0, contentW - 28.0, 18.0), nsFontMonospaced(11.0, kFontWeightRegular()), nsColorSecondaryLabel())));
    cellSet(y, cellGet(y) + card1H + 14.0);

    // Card 2: 平铺参数 + 实时平铺预览
    let card2H = 356.0;
    let (c2, cy2) = addSectionCard(bag, doc, "平铺几何与实时预览", "调整主区比例、主区窗口数与内外边距，立即生效", 18.0, cellGet(y), contentW, card2H, dark);

    // Live TilingPreviewView
    let preview = makeTilingPreviewView(bag, vm, cgRect(14.0, cy2, contentW - 28.0, 140.0), dark);
    nsViewAddSubview(c2, preview);

    let ry = cy2 + 154.0;
    // Row 1: 主区比例
    let rPct = roundToInt(cellGet(vm.masterRatioPercent));
    nsViewAddSubview(c2, idPtrKept(bag, makeLabel("主区比例：" + intToStr(rPct) + "%", cgRect(14.0, ry, 140.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel())));
    let rTgt = makeActionTarget((sender) -> {
        let v = roundFloat(msgSendFloat0(sender, objcSel("doubleValue")));
        cellSet(vm.masterRatioPercent, v);
        vmNotifyChanged(vm, false);
        rebuild()
    });
    let _ = idPtrKept(bag, rTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makeSlider(20.0, 80.0, cellGet(vm.masterRatioPercent), cgRect(160.0, ry - 2.0, contentW - 178.0, 22.0), rTgt)));

    // Row 2: 调整步长 & 主区窗口数
    let ry2 = ry + 36.0;
    nsViewAddSubview(c2, idPtrKept(bag, makeLabel("单次步长：" + intToStr(roundToInt(cellGet(vm.ratioStepPercent))) + "%", cgRect(14.0, ry2, 130.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel())));
    let stepTgt = makeActionTarget((sender) -> {
        let v = roundFloat(msgSendFloat0(sender, objcSel("doubleValue")));
        cellSet(vm.ratioStepPercent, v);
        vmNotifyChanged(vm, false);
        rebuild()
    });
    let _ = idPtrKept(bag, stepTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makeSlider(1.0, 20.0, cellGet(vm.ratioStepPercent), cgRect(160.0, ry2 - 2.0, 150.0, 22.0), stepTgt)));

    nsViewAddSubview(c2, idPtrKept(bag, makeLabel("主区窗口数：" + intToStr(cellGet(vm.masterCount)), cgRect(334.0, ry2, 110.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel())));
    let mcTgt = makeActionTarget((sender) -> {
        let idx = i64ToInt(msgSendI64_0(sender, objcSel("indexOfSelectedItem")));
        cellSet(vm.masterCount, idx + 1);
        vmNotifyChanged(vm, true);
        rebuild()
    });
    let _ = idPtrKept(bag, mcTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makePopUpButton(["1", "2", "3", "4", "5"], minInt(4, maxInt(0, cellGet(vm.masterCount) - 1)), cgRect(contentW - 88.0, ry2 - 5.0, 74.0, 26.0), mcTgt)));

    // Row 3: 外边距
    let ry3 = ry2 + 36.0;
    nsViewAddSubview(c2, idPtrKept(bag, makeLabel("屏幕外边距：" + intToStr(roundToInt(cellGet(vm.outerGap))) + " px", cgRect(14.0, ry3, 140.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel())));
    let ogTgt = makeActionTarget((sender) -> {
        cellSet(vm.outerGap, roundFloat(msgSendFloat0(sender, objcSel("doubleValue"))));
        vmNotifyChanged(vm, false);
        rebuild()
    });
    let _ = idPtrKept(bag, ogTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makeSlider(0.0, 48.0, cellGet(vm.outerGap), cgRect(160.0, ry3 - 2.0, contentW - 178.0, 22.0), ogTgt)));

    // Row 4: 内边距
    let ry4 = ry3 + 36.0;
    nsViewAddSubview(c2, idPtrKept(bag, makeLabel("窗口内间距：" + intToStr(roundToInt(cellGet(vm.innerGap))) + " px", cgRect(14.0, ry4, 140.0, 18.0), nsFontSystem(12.5, kFontWeightRegular()), nsColorLabel())));
    let igTgt = makeActionTarget((sender) -> {
        cellSet(vm.innerGap, roundFloat(msgSendFloat0(sender, objcSel("doubleValue"))));
        vmNotifyChanged(vm, false);
        rebuild()
    });
    let _ = idPtrKept(bag, igTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makeSlider(0.0, 48.0, cellGet(vm.innerGap), cgRect(160.0, ry4 - 2.0, contentW - 178.0, 22.0), igTgt)));

    cellSet(y, cellGet(y) + card2H + 18.0);
    msgSendVoid1Rect(doc, objcSel("setFrame:"), cgRect(0.0, 0.0, width, maxFloat(540.0, cellGet(y))));
    docId
}

def buildRulesTab(ctrl: SettingsWindowController, bag: UIRetainBag, width: Float, dark: Bool, rebuild: () -> Void): Id NSObject = {
    let vm = ctrl.viewModel;
    let contentW = width - 36.0;
    let docId = makeFlippedView(cgRect(0.0, 0.0, width, 640.0));
    let doc = idPtrKept(bag, docId);
    let y = cellNew(14.0);

    // Card 1: 忽略平铺的应用
    let ignored = cellGet(vm.ignoreApps);
    let nIgn = listLen(ignored);
    let card1H = 98.0 + intToFloat(maxInt(1, nIgn)) * 30.0;
    let (c1, cy1) = addSectionCard(bag, doc, "忽略的应用（始终浮动）", "这些应用的窗口不会被 Talus 自动平铺或停放", 18.0, cellGet(y), contentW, card1H, dark);
    let pickIgnTgt = makeActionTarget((_) -> match pickAppBundleId() {
        Some(bid) -> {
            if (!listContainsBy(cellGet(vm.ignoreApps), bid, eqStr)) {
                cellSet(vm.ignoreApps, listAppend(cellGet(vm.ignoreApps), [bid]));
                vmNotifyChanged(vm, true);
                rebuild()
            } else ()
        },
        None -> (),
    });
    let _ = idPtrKept(bag, pickIgnTgt);
    nsViewAddSubview(c1, idPtrKept(bag, makePushButton("+ 选择应用…", cgRect(contentW - 118.0, 12.0, 104.0, 24.0), pickIgnTgt)));

    if (nIgn == 0) {
        nsViewAddSubview(c1, idPtrKept(bag, makeLabel("暂无忽略应用", cgRect(14.0, cy1 + 4.0, 240.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorSecondaryLabel())))
    } else {
        let ri = cellNew(0);
        let cur = cellNew(ignored);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(bid, rest) -> {
                    let rowY = cy1 + intToFloat(cellGet(ri)) * 30.0;
                    nsViewAddSubview(c1, idPtrKept(bag, makeLabel(bid, cgRect(14.0, rowY + 4.0, contentW - 104.0, 18.0), nsFontMonospaced(12.0, kFontWeightRegular()), nsColorLabel())));
                    let delBid = bid;
                    let delTgt = makeActionTarget((_) -> {
                        cellSet(vm.ignoreApps, listFilter(cellGet(vm.ignoreApps), (x) -> x != delBid));
                        vmNotifyChanged(vm, true);
                        rebuild()
                    });
                    let _ = idPtrKept(bag, delTgt);
                    nsViewAddSubview(c1, idPtrKept(bag, makePushButton("移除", cgRect(contentW - 76.0, rowY, 62.0, 24.0), delTgt)));
                    cellSet(ri, cellGet(ri) + 1);
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        }
    };
    cellSet(y, cellGet(y) + card1H + 14.0);

    // Card 2: 应用归属工作区 (app_workspaces)
    let assigns = cellGet(vm.appWorkspaces);
    let nAss = listLen(assigns);
    let card2H = 98.0 + intToFloat(maxInt(1, nAss)) * 30.0;
    let (c2, cy2) = addSectionCard(bag, doc, "应用归属工作区", "打开指定应用时自动归位到对应虚拟工作区", 18.0, cellGet(y), contentW, card2H, dark);
    let pickAssTgt = makeActionTarget((_) -> match pickAppBundleId() {
        Some(bid) -> {
            let filtered = listFilter(cellGet(vm.appWorkspaces), (p) -> { let (k, _) = p; k != bid });
            cellSet(vm.appWorkspaces, listAppend(filtered, [(bid, WsIndex(2))]));
            vmNotifyChanged(vm, true);
            rebuild()
        },
        None -> (),
    });
    let _ = idPtrKept(bag, pickAssTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makePushButton("+ 添加归属…", cgRect(contentW - 118.0, 12.0, 104.0, 24.0), pickAssTgt)));

    if (nAss == 0) {
        nsViewAddSubview(c2, idPtrKept(bag, makeLabel("暂无应用归属规则", cgRect(14.0, cy2 + 4.0, 240.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorSecondaryLabel())))
    } else {
        let wsLabels = cellGet(vm.spaceLabels);
        let wsCount = cellGet(vm.workspaceCount);
        let ri = cellNew(0);
        let cur = cellNew(assigns);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((bid, target), rest) -> {
                    let rowY = cy2 + intToFloat(cellGet(ri)) * 30.0;
                    let wsText = match target {
                        WsIndex(n) -> "工作区 " + intToStr(n),
                        WsLabel(l) -> "工作区 · " + l,
                    };
                    let _ = resolveWorkspaceTarget(target, wsCount, wsLabels);
                    nsViewAddSubview(c2, idPtrKept(bag, makeLabel(bid, cgRect(14.0, rowY + 4.0, contentW - 210.0, 18.0), nsFontMonospaced(12.0, kFontWeightRegular()), nsColorLabel())));
                    nsViewAddSubview(c2, idPtrKept(bag, makeLabel(wsText, cgRect(contentW - 186.0, rowY + 4.0, 104.0, 18.0), nsFontSystem(12.0, kFontWeightMedium()), nsColorControlAccent())));
                    let delBid = bid;
                    let delTgt = makeActionTarget((_) -> {
                        cellSet(vm.appWorkspaces, listFilter(cellGet(vm.appWorkspaces), (p) -> { let (k, _) = p; k != delBid }));
                        vmNotifyChanged(vm, true);
                        rebuild()
                    });
                    let _ = idPtrKept(bag, delTgt);
                    nsViewAddSubview(c2, idPtrKept(bag, makePushButton("移除", cgRect(contentW - 76.0, rowY, 62.0, 24.0), delTgt)));
                    cellSet(ri, cellGet(ri) + 1);
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        }
    };
    cellSet(y, cellGet(y) + card2H + 14.0);

    // Card 3: 按标题自动浮动规则 (float_windows)
    let rules = cellGet(vm.floatWindows);
    let nRules = listLen(rules);
    let card3H = 98.0 + intToFloat(maxInt(1, nRules)) * 30.0;
    let (c3, cy3) = addSectionCard(bag, doc, "按窗口标题自动浮动（[[rules.float_windows]]）", "匹配 Bundle ID 与标题通配符的弹窗/画中画窗口自动保持浮动", 18.0, cellGet(y), contentW, card3H, dark);
    if (nRules == 0) {
        nsViewAddSubview(c3, idPtrKept(bag, makeLabel("暂无标题浮动规则（可在 config.toml 中配置 [[rules.float_windows]]）", cgRect(14.0, cy3 + 4.0, contentW - 28.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorSecondaryLabel())))
    } else {
        let ri = cellNew(0);
        let cur = cellNew(rules);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(rule, rest) -> {
                    let rowY = cy3 + intToFloat(cellGet(ri)) * 30.0;
                    let idxDel = cellGet(ri);
                    let appStr = rule.app;
                    let titleStr = match rule.titles {
                        Some(ts) -> "titles=[" + strJoin(ts, ", ") + "]",
                        None -> match rule.exceptTitles {
                            Some(ets) -> "except=[" + strJoin(ets, ", ") + "]",
                            None -> "*",
                        },
                    };
                    nsViewAddSubview(c3, idPtrKept(bag, makeLabel(appStr + "  ·  " + titleStr, cgRect(14.0, rowY + 4.0, contentW - 104.0, 18.0), nsFontMonospaced(11.5, kFontWeightRegular()), nsColorLabel())));
                    let delTgt = makeActionTarget((_) -> {
                        cellSet(vm.floatWindows, listRemoveAt(cellGet(vm.floatWindows), idxDel));
                        vmNotifyChanged(vm, true);
                        rebuild()
                    });
                    let _ = idPtrKept(bag, delTgt);
                    nsViewAddSubview(c3, idPtrKept(bag, makePushButton("移除", cgRect(contentW - 76.0, rowY, 62.0, 24.0), delTgt)));
                    cellSet(ri, idxDel + 1);
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        }
    };

    cellSet(y, cellGet(y) + card3H + 18.0);
    msgSendVoid1Rect(doc, objcSel("setFrame:"), cgRect(0.0, 0.0, width, maxFloat(460.0, cellGet(y))));
    docId
}

def addMenuBarPreviewRow(bag: UIRetainBag, parent: Ptr, label: String, darkPill: Bool, img: Id NSObject, x: Float, y: Float, w: Float): Void = {
    nsViewAddSubview(parent, idPtrKept(bag, makeLabel(label, cgRect(x, y + 6.0, 38.0, 18.0), nsFontSystem(11.5, kFontWeightMedium()), nsColorSecondaryLabel())));
    let pillId = makeFlippedView(cgRect(x + 44.0, y, w - 44.0, 30.0));
    let pill = idPtrKept(bag, pillId);
    let bg = if (darkPill) nsColorSRGB(0.13, 0.14, 0.17, 1.0) else nsColorSRGB(0.92, 0.93, 0.95, 1.0);
    let border = if (darkPill) nsColorSRGB(1.0, 1.0, 1.0, 0.14) else nsColorSRGB(0.0, 0.0, 0.0, 0.12);
    nsViewSetLayerStyle(pill, Some(bg), Some(border), 1.0, 12.0);
    nsViewAddSubview(parent, pill);
    let iv = idPtrKept(bag, makeImageView(cgRect(12.0, 6.0, w - 68.0, 18.0), Some(img)));
    msgSendVoid1I64(iv, objcSel("setImageAlignment:"), intToI64(4)); // NSImageAlignLeft
    nsViewAddSubview(pill, iv)
}

def buildStatusTab(ctrl: SettingsWindowController, bag: UIRetainBag, width: Float, dark: Bool, rebuild: () -> Void): Id NSObject = {
    let vm = ctrl.viewModel;
    let contentW = width - 36.0;
    let docId = makeFlippedView(cgRect(0.0, 0.0, width, 760.0));
    let doc = idPtrKept(bag, docId);
    let y = cellNew(14.0);

    // Card 1: 菜单栏实时预览（深色 + 浅色双栏）
    let card1H = 154.0;
    let (c1, cy1) = addSectionCard(bag, doc, "菜单栏实时预览", "所见即所得：深色与浅色外观下的矢量渲染效果", 18.0, cellGet(y), contentW, card1H, dark);
    let darkImg = vmPreviewImage(vm, true);
    let lightImg = vmPreviewImage(vm, false);
    addMenuBarPreviewRow(bag, c1, "深色", true, darkImg, 14.0, cy1, contentW - 28.0);
    addMenuBarPreviewRow(bag, c1, "浅色", false, lightImg, 14.0, cy1 + 38.0, contentW - 28.0);

    let iconTgt = makeActionTarget((sender) -> {
        cellSet(vm.statusShowIcon, controlStateOn(sender));
        vmNotifyChanged(vm, true);
        rebuild()
    });
    let _ = idPtrKept(bag, iconTgt);
    nsViewAddSubview(c1, idPtrKept(bag, makeCheckbox("在状态栏左侧显示 Talus 图标", cellGet(vm.statusShowIcon), cgRect(14.0, cy1 + 76.0, 260.0, 20.0), iconTgt)));
    cellSet(y, cellGet(y) + card1H + 14.0);

    // Card 2: 显示模式与预设
    let mode = cellGet(vm.statusMode);
    let card2H = match mode {
        ModeSimple -> 108.0,
        ModeTemplate -> 276.0,
        ModeScript -> 252.0,
    };
    let (c2, cy2) = addSectionCard(bag, doc, "状态栏样式与模板", "在简洁默认、富文本模板或外部脚本接管之间切换", 18.0, cellGet(y), contentW, card2H, dark);
    let modeTgt = makeActionTarget((sender) -> {
        let seg = i64ToInt(msgSendI64_0(sender, objcSel("selectedSegment")));
        cellSet(vm.statusMode, statusModeFromIndex(seg));
        vmNotifyChanged(vm, true);
        rebuild()
    });
    let _ = idPtrKept(bag, modeTgt);
    nsViewAddSubview(c2, idPtrKept(bag, makeSegmentedControl(["简洁默认", "自定义模板", "脚本完全接管"], statusModeIndex(mode), cgRect(14.0, cy2, 340.0, 26.0), modeTgt)));

    match mode {
        ModeSimple -> (),
        ModeTemplate -> {
            // Preset buttons row
            let py = cy2 + 38.0;
            let presets = [("图标", "icons"), ("紧凑", "compact"), ("下划线", "underline"), ("胶囊", "pills"), ("Powerline", "powerline"), ("时钟", "clock")];
            let px = cellNew(14.0);
            let cp = cellNew(presets);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons((lbl, key), rp) -> {
                        let pKey = key;
                        let pt = makeActionTarget((_) -> { vmApplyTemplatePreset(vm, pKey); rebuild() });
                        let _ = idPtrKept(bag, pt);
                        let bw = if (key == "powerline") 82.0 else 64.0;
                        nsViewAddSubview(c2, idPtrKept(bag, makePushButton(lbl, cgRect(cellGet(px), py, bw, 24.0), pt)));
                        cellSet(px, cellGet(px) + bw + 6.0);
                        cellSet(cp, rp)
                    },
                    Nil -> (),
                }
            };

            let fy1 = py + 34.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("模板", cgRect(14.0, fy1 + 3.0, 88.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfTmpl = idPtrKept(bag, makeTextField(cellGet(vm.customTemplate), "%spaces%  %layout%", cgRect(104.0, fy1, contentW - 118.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dTmpl = makeTextChangeDelegate((tf) -> { cellSet(vm.customTemplate, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfTmpl, objcSel("setDelegate:"), idPtrKept(bag, dTmpl));
            nsViewAddSubview(c2, tfTmpl);

            let fy2 = fy1 + 32.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("当前工作区", cgRect(14.0, fy2 + 3.0, 88.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfCur = idPtrKept(bag, makeTextField(cellGet(vm.workspaceCurrent), "<fc=#FFFFFF,#0F766E> %index%:%label% </fc>", cgRect(104.0, fy2, contentW - 118.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dCur = makeTextChangeDelegate((tf) -> { cellSet(vm.workspaceCurrent, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfCur, objcSel("setDelegate:"), idPtrKept(bag, dCur));
            nsViewAddSubview(c2, tfCur);

            let fy3 = fy2 + 32.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("其他工作区", cgRect(14.0, fy3 + 3.0, 88.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfOth = idPtrKept(bag, makeTextField(cellGet(vm.workspaceOther), " %index%:%label%%occupied% ", cgRect(104.0, fy3, contentW - 118.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dOth = makeTextChangeDelegate((tf) -> { cellSet(vm.workspaceOther, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfOth, objcSel("setDelegate:"), idPtrKept(bag, dOth));
            nsViewAddSubview(c2, tfOth);

            let fy4 = fy3 + 34.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("字体 / 字号", cgRect(14.0, fy4 + 3.0, 88.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfFont = idPtrKept(bag, makeTextField(cellGet(vm.primaryFont), "默认系统等宽数字字体", cgRect(104.0, fy4, 240.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dFont = makeTextChangeDelegate((tf) -> { cellSet(vm.primaryFont, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfFont, objcSel("setDelegate:"), idPtrKept(bag, dFont));
            nsViewAddSubview(c2, tfFont);

            nsViewAddSubview(c2, idPtrKept(bag, makeLabel(intToStr(roundToInt(cellGet(vm.statusFontSize))) + " pt", cgRect(356.0, fy4 + 3.0, 46.0, 18.0), nsFontMonospacedDigit(12.0, kFontWeightMedium()), nsColorSecondaryLabel())));
            let fsTgt = makeActionTarget((sender) -> {
                cellSet(vm.statusFontSize, roundFloat(msgSendFloat0(sender, objcSel("doubleValue"))));
                vmNotifyChanged(vm, false);
                rebuild()
            });
            let _ = idPtrKept(bag, fsTgt);
            nsViewAddSubview(c2, idPtrKept(bag, makeSlider(9.0, 16.0, cellGet(vm.statusFontSize), cgRect(404.0, fy4 + 1.0, contentW - 418.0, 22.0), fsTgt)))
        },
        ModeScript -> {
            let fy1 = cy2 + 38.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("脚本路径", cgRect(14.0, fy1 + 3.0, 80.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfExec = idPtrKept(bag, makeTextField(cellGet(vm.scriptExecutable), "/usr/bin/python3", cgRect(96.0, fy1, contentW - 188.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dExec = makeTextChangeDelegate((tf) -> { cellSet(vm.scriptExecutable, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfExec, objcSel("setDelegate:"), idPtrKept(bag, dExec));
            nsViewAddSubview(c2, tfExec);
            let brTgt = makeActionTarget((_) -> match pickExecutableFile() {
                Some(p) -> { cellSet(vm.scriptExecutable, p); vmNotifyChanged(vm, true); rebuild() },
                None -> (),
            });
            let _ = idPtrKept(bag, brTgt);
            nsViewAddSubview(c2, idPtrKept(bag, makePushButton("浏览…", cgRect(contentW - 84.0, fy1, 70.0, 24.0), brTgt)));

            let fy2 = fy1 + 34.0;
            nsViewAddSubview(c2, idPtrKept(bag, makeLabel("参数", cgRect(14.0, fy2 + 3.0, 80.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
            let tfArgs = idPtrKept(bag, makeTextField(cellGet(vm.scriptArgumentsText), "以空格分隔，支持引号", cgRect(96.0, fy2, contentW - 110.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
            let dArgs = makeTextChangeDelegate((tf) -> { cellSet(vm.scriptArgumentsText, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
            msgSendVoid1Ptr(tfArgs, objcSel("setDelegate:"), idPtrKept(bag, dArgs));
            nsViewAddSubview(c2, tfArgs);

            let fy3 = fy2 + 36.0;
            let mkTgt = makeActionTarget((sender) -> { cellSet(vm.scriptMarkup, controlStateOn(sender)); vmNotifyChanged(vm, true) });
            let ocTgt = makeActionTarget((sender) -> { cellSet(vm.scriptOnChange, controlStateOn(sender)); vmNotifyChanged(vm, true) });
            let _ = idPtrKept(bag, mkTgt);
            let _ = idPtrKept(bag, ocTgt);
            nsViewAddSubview(c2, idPtrKept(bag, makeCheckbox("解析颜色标记 (<fc>/<bg>/<box>)", cellGet(vm.scriptMarkup), cgRect(14.0, fy3, 240.0, 20.0), mkTgt)));
            nsViewAddSubview(c2, idPtrKept(bag, makeCheckbox("状态变化时立即重新执行", cellGet(vm.scriptOnChange), cgRect(270.0, fy3, 220.0, 20.0), ocTgt)))
        },
    };
    cellSet(y, cellGet(y) + card2H + 14.0);

    // Card 3: 工作区标签、图标与状态导出文件
    let card3H = 196.0;
    let (c3, cy3) = addSectionCard(bag, doc, "工作区标签与状态文件 I/O", "以逗号分隔填写工作区名称或 SF Symbol 图标名（如 terminal, globe）", 18.0, cellGet(y), contentW, card3H, dark);

    nsViewAddSubview(c3, idPtrKept(bag, makeLabel("工作区名称", cgRect(14.0, cy3 + 3.0, 92.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
    let tfLbls = idPtrKept(bag, makeTextField(strJoin(cellGet(vm.spaceLabels), ", "), "Code, Web, Chat", cgRect(108.0, cy3, contentW - 122.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
    let dLbls = makeTextChangeDelegate((tf) -> {
        let raw = textFieldStringValue(tf);
        let parts = std.str.strSplitChar(raw, ',');
        let cleaned = listFilter(listMap(parts, (s) -> strTrim(s)), (s) -> strLen(s) > 0);
        cellSet(vm.spaceLabels, cleaned);
        vmNotifyChanged(vm, false)
    });
    msgSendVoid1Ptr(tfLbls, objcSel("setDelegate:"), idPtrKept(bag, dLbls));
    nsViewAddSubview(c3, tfLbls);

    let fy2 = cy3 + 32.0;
    nsViewAddSubview(c3, idPtrKept(bag, makeLabel("SF Symbol 图标", cgRect(14.0, fy2 + 3.0, 92.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
    let tfIcons = idPtrKept(bag, makeTextField(strJoin(cellGet(vm.workspaceIcons), ", "), "terminal, globe, bubble.left.and.bubble.right", cgRect(108.0, fy2, contentW - 122.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
    let dIcons = makeTextChangeDelegate((tf) -> {
        let raw = textFieldStringValue(tf);
        let parts = std.str.strSplitChar(raw, ',');
        let cleaned = listFilter(listMap(parts, (s) -> strTrim(s)), (s) -> strLen(s) > 0);
        cellSet(vm.workspaceIcons, cleaned);
        vmNotifyChanged(vm, false)
    });
    msgSendVoid1Ptr(tfIcons, objcSel("setDelegate:"), idPtrKept(bag, dIcons));
    nsViewAddSubview(c3, tfIcons);

    let fy3 = fy2 + 32.0;
    nsViewAddSubview(c3, idPtrKept(bag, makeLabel("自定义文本文件", cgRect(14.0, fy3 + 3.0, 92.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
    let tfTxtF = idPtrKept(bag, makeTextField(cellGet(vm.statusTextFile), "可选，用于 %custom% 占位符", cgRect(108.0, fy3, contentW - 122.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
    let dTxtF = makeTextChangeDelegate((tf) -> { cellSet(vm.statusTextFile, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
    msgSendVoid1Ptr(tfTxtF, objcSel("setDelegate:"), idPtrKept(bag, dTxtF));
    nsViewAddSubview(c3, tfTxtF);

    let fy4 = fy3 + 32.0;
    nsViewAddSubview(c3, idPtrKept(bag, makeLabel("导出状态 JSON", cgRect(14.0, fy4 + 3.0, 92.0, 18.0), nsFontSystem(12.0, kFontWeightRegular()), nsColorLabel())));
    let tfStF = idPtrKept(bag, makeTextField(cellGet(vm.statusStateFile), "可选，自动写入当前工作区与标题 JSON", cgRect(108.0, fy4, contentW - 122.0, 24.0), nsFontMonospaced(11.5, kFontWeightRegular())));
    let dStF = makeTextChangeDelegate((tf) -> { cellSet(vm.statusStateFile, textFieldStringValue(tf)); vmNotifyChanged(vm, false) });
    msgSendVoid1Ptr(tfStF, objcSel("setDelegate:"), idPtrKept(bag, dStF));
    nsViewAddSubview(c3, tfStF);

    cellSet(y, cellGet(y) + card3H + 18.0);
    msgSendVoid1Rect(doc, objcSel("setFrame:"), cgRect(0.0, 0.0, width, maxFloat(540.0, cellGet(y))));
    docId
}

pub def settingsRebuildActiveTab(ctrl: SettingsWindowController): Void = {
    let sv = cellGet(ctrl.scrollView);
    if (!ptrIsNull(sv)) {
        cellSet(ctrl.bag.items, Nil);
        let bounds = msgSendRect0(sv, objcSel("bounds"));
        let w = maxFloat(600.0, bounds.size.w);
        let dark = nsAppearanceIsDark(sv);
        match cellGet(ctrl.window) {
            Some(winId) -> {
                let root = msgSend0(idPtrKept(ctrl.chromeBag, winId), objcSel("contentView"));
                if (!ptrIsNull(root)) {
                    let winBg = if (dark) nsColorSRGB(0.118, 0.118, 0.125, 1.0) else nsColorSRGB(0.955, 0.955, 0.962, 1.0);
                    nsViewSetLayerStyle(root, Some(winBg), None, 0.0, 0.0)
                } else ()
            },
            None -> (),
        };
        let rebuild = () -> settingsRebuildActiveTab(ctrl);
        let docId = match cellGet(ctrl.viewModel.selectedTab) {
            TabGeneral -> buildGeneralTab(ctrl, ctrl.bag, w, dark, rebuild),
            TabLayout -> buildLayoutTab(ctrl, ctrl.bag, w, dark, rebuild),
            TabRules -> buildRulesTab(ctrl, ctrl.bag, w, dark, rebuild),
            TabStatus -> buildStatusTab(ctrl, ctrl.bag, w, dark, rebuild),
        };
        let docPtr = idPtrKept(ctrl.bag, docId);
        msgSendVoid1Ptr(sv, objcSel("setDocumentView:"), docPtr);
        let segPtr = cellGet(ctrl.tabSegment);
        if (!ptrIsNull(segPtr)) {
            msgSendVoid1I64(segPtr, objcSel("setSelectedSegment:"), intToI64(settingsTabIndex(cellGet(ctrl.viewModel.selectedTab))))
        } else ();
        updateBannerLabels(ctrl)
    } else ()
}

pub def settingsControllerNew(
    cfg: Configuration,
    res: ConfigResolution,
    onApply: (Configuration, String) -> Void
): SettingsWindowController = {
    let login = launchAtLoginNew(systemLaunchAtLoginService());
    let vm = settingsViewModelNew(cfg, res, login);
    cellSet(vm.onConfigurationApplied, Some(onApply));
    let ctrl = SettingsWindowController {
        viewModel: vm,
        window: cellNew(None),
        tabSegment: cellNew(ptrNull()),
        scrollView: cellNew(ptrNull()),
        bannerLabel: cellNew(ptrNull()),
        validationLabel: cellNew(ptrNull()),
        bag: retainBagNew(),
        chromeBag: retainBagNew(),
        onClose: cellNew(None),
        isPreviewMode: cellNew(false),
    };
    cellSet(vm.onUIStateChanged, Some(() -> updateBannerLabels(ctrl)));
    ctrl
}

def ensureWindowCreated(ctrl: SettingsWindowController): Ptr = {
    match cellGet(ctrl.window) {
        Some(winId) -> idPtrKept(ctrl.chromeBag, winId),
        None -> {
            // styleMask = titled(1) | closable(2) | miniaturizable(4) | resizable(8) = 15
            let alloc = msgSend0(objcClass("NSWindow"), objcSel("alloc"));
            let rawWin = msgSend1Rect1I641I641Bool(
                alloc,
                objcSel("initWithContentRect:styleMask:backing:defer:"),
                cgRect(0.0, 0.0, 640.0, 680.0),
                intToI64(15),
                intToI64(2), // NSBackingStoreBuffered
                false
            );
            let winId = idAdopt(rawWin);
            cellSet(ctrl.window, Some(winId));
            let titleNs = nsString("Talus 设置");
            withId(titleNs, (tp) -> {
                c_winTitle(rawWin, objcSel("setTitle:"), tp)
            });
            msgSendVoid1I64(rawWin, objcSel("setCollectionBehavior:"), intToI64(2)); // moveToActiveSpace
            msgSendVoid1Size(rawWin, objcSel("setMinSize:"), cgSize(600.0, 560.0));
            msgSendVoid1Bool(rawWin, objcSel("setReleasedWhenClosed:"), false);
            msgSendVoid0(rawWin, objcSel("center"));

            let winDel = makeWindowCloseDelegate(() -> {
                vmFlushPendingSave(ctrl.viewModel);
                match cellGet(ctrl.onClose) { Some(cb) -> cb(), None -> () }
            });
            msgSendVoid1Ptr(rawWin, objcSel("setDelegate:"), idPtrKept(ctrl.chromeBag, winDel));

            // Root flipped view (640x680)
            let rootId = makeFlippedView(cgRect(0.0, 0.0, 640.0, 680.0));
            let root = idPtrKept(ctrl.chromeBag, rootId);
            msgSendVoid1Ptr(rawWin, objcSel("setContentView:"), root);

            // Top tab header bar (height 52)
            let tabTgt = makeActionTarget((sender) -> {
                let idx = i64ToInt(msgSendI64_0(sender, objcSel("selectedSegment")));
                cellSet(ctrl.viewModel.selectedTab, settingsTabFromIndex(idx));
                settingsRebuildActiveTab(ctrl)
            });
            let _ = idPtrKept(ctrl.chromeBag, tabTgt);
            let seg = idPtrKept(ctrl.chromeBag, makeSegmentedControl(
                ["通用", "快捷键与布局", "应用规则", "菜单栏"],
                settingsTabIndex(cellGet(ctrl.viewModel.selectedTab)),
                cgRect(120.0, 12.0, 400.0, 28.0),
                tabTgt
            ));
            msgSendVoid1I64(seg, objcSel("setAutoresizingMask:"), intToI64(5)); // flex left+right
            nsViewAddSubview(root, seg);
            cellSet(ctrl.tabSegment, seg);

            // Hairline separator below header
            let sepTop = idPtrKept(ctrl.chromeBag, makeFlippedView(cgRect(0.0, 52.0, 640.0, 1.0)));
            nsViewSetLayerStyle(sepTop, Some(nsColorSeparator()), None, 0.0, 0.0);
            msgSendVoid1I64(sepTop, objcSel("setAutoresizingMask:"), intToI64(2)); // width sizable
            nsViewAddSubview(root, sepTop);

            // ScrollView (middle content area: y=53..636)
            let svRaw = msgSend1Rect(msgSend0(objcClass("NSScrollView"), objcSel("alloc")), objcSel("initWithFrame:"), cgRect(0.0, 53.0, 640.0, 583.0));
            let svId = idAdopt(svRaw);
            let sv = idPtrKept(ctrl.chromeBag, svId);
            msgSendVoid1Bool(sv, objcSel("setHasVerticalScroller:"), true);
            msgSendVoid1Bool(sv, objcSel("setDrawsBackground:"), false);
            msgSendVoid1I64(sv, objcSel("setAutoresizingMask:"), intToI64(18)); // width + height sizable
            nsViewAddSubview(root, sv);
            cellSet(ctrl.scrollView, sv);

            // Hairline separator above footer
            let sepBot = idPtrKept(ctrl.chromeBag, makeFlippedView(cgRect(0.0, 636.0, 640.0, 1.0)));
            nsViewSetLayerStyle(sepBot, Some(nsColorSeparator()), None, 0.0, 0.0);
            msgSendVoid1I64(sepBot, objcSel("setAutoresizingMask:"), intToI64(10)); // width + minY margin
            nsViewAddSubview(root, sepBot);

            // Footer bar (y=637..680)
            let banner = idPtrKept(ctrl.chromeBag, makeLabel(cellGet(ctrl.viewModel.statusBanner), cgRect(18.0, 650.0, 380.0, 18.0), nsFontSystem(11.5, kFontWeightRegular()), nsColorSecondaryLabel()));
            msgSendVoid1I64(banner, objcSel("setAutoresizingMask:"), intToI64(10));
            nsViewAddSubview(root, banner);
            cellSet(ctrl.bannerLabel, banner);

            let valLbl = idPtrKept(ctrl.chromeBag, makeLabel("", cgRect(404.0, 650.0, 218.0, 18.0), nsFontSystem(11.5, kFontWeightMedium()), nsColorSystemRed()));
            msgSendVoid1Bool(valLbl, objcSel("setHidden:"), true);
            msgSendVoid1I64(valLbl, objcSel("setAutoresizingMask:"), intToI64(9));
            nsViewAddSubview(root, valLbl);
            cellSet(ctrl.validationLabel, valLbl);

            settingsRebuildActiveTab(ctrl);
            rawWin
        },
    }
}

pub def settingsControllerShow(ctrl: SettingsWindowController): Void = {
    launchAtLoginRefresh(ctrl.viewModel.launchAtLogin);
    installEditMenuIfNeeded();
    let win = ensureWindowCreated(ctrl);
    settingsRebuildActiveTab(ctrl);
    let app = nsAppShared();
    msgSendVoid1Bool(app, objcSel("activateIgnoringOtherApps:"), true);
    msgSendVoid1Ptr(win, objcSel("makeKeyAndOrderFront:"), ptrNull())
}

/// Offline high-DPI preview renderer for all 4 Settings tabs (light & dark), invoked by `--render-previews <dir>`.
pub def renderSettingsPreviews(cfg: Configuration, res: ConfigResolution, outDir: String): Bool = withAutoreleasePool(() -> {
    let _ = mkdirAll(outDir);
    let app = nsAppShared();
    msgSendVoid1I64(app, objcSel("setActivationPolicy:"), intToI64(2)); // prohibited (headless)
    let ctrl = settingsControllerNew(cfg, res, (_, _) -> ());
    cellSet(ctrl.isPreviewMode, true);
    let win = ensureWindowCreated(ctrl);
    let contentView = msgSend0(win, objcSel("contentView"));
    let tabs = [
        ("general", TabGeneral),
        ("layout", TabLayout),
        ("rules", TabRules),
        ("status", TabStatus),
    ];
    let ok = cellNew(true);
    let ct = cellNew(tabs);
    while (match cellGet(ct) { Nil -> false, _ -> true }) {
        match cellGet(ct) {
            Cons((name, tab), rest) -> {
                cellSet(ctrl.viewModel.selectedTab, tab);
                // Render Light mode
                let lightName = nsString("NSAppearanceNameAqua");
                let lightApp = withId(lightName, (np) -> {
                    c_appNamed(objcClass("NSAppearance"), objcSel("appearanceNamed:"), np)
                });
                msgSendVoid1Ptr(app, objcSel("setAppearance:"), lightApp);
                msgSendVoid1Ptr(win, objcSel("setAppearance:"), lightApp);
                msgSendVoid1Ptr(contentView, objcSel("setAppearance:"), lightApp);
                msgSendVoid1Ptr(objcClass("NSAppearance"), objcSel("setCurrentAppearance:"), lightApp);
                settingsRebuildActiveTab(ctrl);
                msgSendVoid0(contentView, objcSel("layoutSubtreeIfNeeded"));
                if (!nsViewWritePng(contentView, outDir + "/settings-" + name + "-light.png", 2.0)) cellSet(ok, false) else ();

                // Render Dark mode
                let darkName = nsString("NSAppearanceNameDarkAqua");
                let darkApp = withId(darkName, (np) -> {
                    c_appNamed2(objcClass("NSAppearance"), objcSel("appearanceNamed:"), np)
                });
                msgSendVoid1Ptr(app, objcSel("setAppearance:"), darkApp);
                msgSendVoid1Ptr(win, objcSel("setAppearance:"), darkApp);
                msgSendVoid1Ptr(contentView, objcSel("setAppearance:"), darkApp);
                msgSendVoid1Ptr(objcClass("NSAppearance"), objcSel("setCurrentAppearance:"), darkApp);
                settingsRebuildActiveTab(ctrl);
                msgSendVoid0(contentView, objcSel("layoutSubtreeIfNeeded"));
                if (!nsViewWritePng(contentView, outDir + "/settings-" + name + "-dark.png", 2.0)) cellSet(ok, false) else ();

                cellSet(ct, rest)
            },
            Nil -> (),
        }
    };
    cellGet(ok)
})
