// ---------------------------------------------------------------------------
// Settings Tab & Status Mode enums
// ---------------------------------------------------------------------------

pub data SettingsTab {
    TabGeneral,
    TabLayout,
    TabRules,
    TabStatus,
}

pub def settingsTabFromStr(s: String): Option SettingsTab =
    if (s == "general") Some(TabGeneral)
    else if (s == "layout") Some(TabLayout)
    else if (s == "rules") Some(TabRules)
    else if (s == "status") Some(TabStatus)
    else None

pub def settingsTabIndex(t: SettingsTab): Int = match t {
    TabGeneral -> 0,
    TabLayout -> 1,
    TabRules -> 2,
    TabStatus -> 3,
}

pub def settingsTabFromIndex(i: Int): SettingsTab =
    if (i == 0) TabGeneral
    else if (i == 1) TabLayout
    else if (i == 2) TabRules
    else TabStatus

pub data StatusModeChoice {
    ModeSimple,
    ModeTemplate,
    ModeScript,
}

def statusModeIndex(m: StatusModeChoice): Int = match m {
    ModeSimple -> 0,
    ModeTemplate -> 1,
    ModeScript -> 2,
}

def statusModeFromIndex(i: Int): StatusModeChoice =
    if (i == 0) ModeSimple
    else if (i == 1) ModeTemplate
    else ModeScript

// Signal tag reserved for SettingsViewModel 150ms debounced save
pub def kSettingsDebounceSaveSignalTag(): Int = 9001

// ---------------------------------------------------------------------------
// Argument line splitter (matches SettingsWindow.swift `parseArgumentLine`)
// ---------------------------------------------------------------------------

pub def parseArgumentLine(line: String): List String = {
    let n = strLen(line);
    let outRev: Cell (List String) = cellNew(Nil);
    let cur = cellNew("");
    let inQuote = cellNew(0); // 0 = none, 34 = ", 39 = '
    let hasToken = cellNew(false);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let b = strByteAt(line, idx);
        let q = cellGet(inQuote);
        if (q != 0) {
            if (b == q) cellSet(inQuote, 0)
            else cellSet(cur, cellGet(cur) + ptrSliceFromStr(line, idx, 1))
        } else if (b == 34 || b == 39) {
            cellSet(inQuote, b);
            cellSet(hasToken, true)
        } else if (b == 32 || b == 9) {
            if (cellGet(hasToken)) {
                cellSet(outRev, Cons(cellGet(cur), cellGet(outRev)));
                cellSet(cur, "");
                cellSet(hasToken, false)
            } else ()
        } else {
            cellSet(cur, cellGet(cur) + ptrSliceFromStr(line, idx, 1));
            cellSet(hasToken, true)
        };
        cellSet(i, idx + 1)
    };
    if (cellGet(hasToken)) cellSet(outRev, Cons(cellGet(cur), cellGet(outRev))) else ();
    listRev(cellGet(outRev))
}

// ---------------------------------------------------------------------------
// SettingsViewModel
// ---------------------------------------------------------------------------

pub data SettingsViewModel {
    SettingsViewModel {
        selectedTab: Cell SettingsTab,
        launchAtLogin: LaunchAtLoginModel,
        modifiers: Cell (List String),
        workspaceMode: Cell String,
        workspaceCount: Cell Int,
        masterRatioPercent: Cell Float,
        ratioStepPercent: Cell Float,
        masterCount: Cell Int,
        outerGap: Cell Float,
        innerGap: Cell Float,
        ignoreApps: Cell (List String),
        appWorkspaces: Cell (List (String, WorkspaceTarget)),
        floatWindows: Cell (List FloatWindowRule),
        statusShowIcon: Cell Bool,
        spaceLabels: Cell (List String),
        workspaceIcons: Cell (List String),
        statusMode: Cell StatusModeChoice,
        customTemplate: Cell String,
        workspaceCurrent: Cell String,
        workspaceOther: Cell String,
        primaryFont: Cell String,
        extraFonts: Cell (List String),
        statusFontSize: Cell Float,
        commands: Cell (List StatusCommand),
        scriptName: Cell String,
        scriptExecutable: Cell String,
        scriptArgumentsText: Cell String,
        scriptInterval: Cell Float,
        scriptTimeout: Cell Float,
        scriptMarkup: Cell Bool,
        scriptOnChange: Cell Bool,
        statusTextFile: Cell String,
        statusStateFile: Cell String,
        savePath: Cell String,
        migratedFromJson: Cell Bool,
        statusBanner: Cell String,
        validationMessage: Cell (Option String),
        legacyFormat: Cell String,
        suppressAutoSave: Cell Bool,
        pendingSaveGen: Cell Int,
        lastWrittenMs: Cell Int64,
        onConfigurationApplied: Cell (Option ((Configuration, String) -> Void)),
        onUIStateChanged: Cell (Option (() -> Void)),
    }
}

def detectStatusMode(cfg: Configuration): (StatusModeChoice, String, String, String, String, Float, Float, Bool, Bool) = {
    let defs = defaultConfig();
    let defaultTmpl = "%spaces%  <fc=#89CFC2>%layout%</fc>";
    match cfg.statusCommands {
        Cons(only, Nil) -> {
            let expected = "%" + only.name + "%";
            let isScript = match cfg.statusTemplate {
                Some(t) -> strTrim(t) == expected,
                None -> false,
            };
            if (isScript) {
                let argsText = match only.arguments { Some(a) -> strJoin(a, " "), None -> "" };
                let iv = match only.interval { Some(v) -> v, None -> 10.0 };
                let to = match only.timeout { Some(v) -> v, None -> 2.0 };
                let mk = match only.markup { Some(b) -> b, None -> true };
                let oc = match only.onChange { Some(b) -> b, None -> true };
                (ModeScript, defaultTmpl, only.name, only.executable, argsText, iv, to, mk, oc)
            } else {
                let tmpl = match cfg.statusTemplate { Some(t) -> t, None -> defaultTmpl };
                (ModeTemplate, tmpl, "mybar", "/usr/bin/python3", "", 10.0, 2.0, true, true)
            }
        },
        _ -> {
            let hasCustom = (match cfg.statusTemplate { Some(_) -> true, None -> false })
                || listLen(cfg.statusCommands) > 0
                || cfg.statusFormat != defs.statusFormat;
            if (hasCustom) {
                let tmpl = match cfg.statusTemplate { Some(t) -> t, None -> defaultTmpl };
                (ModeTemplate, tmpl, "mybar", "/usr/bin/python3", "", 10.0, 2.0, true, true)
            } else {
                (ModeSimple, defaultTmpl, "mybar", "/usr/bin/python3", "", 10.0, 2.0, true, true)
            }
        },
    }
}

pub def settingsViewModelNew(
    cfg: Configuration,
    res: ConfigResolution,
    loginModel: LaunchAtLoginModel
): SettingsViewModel = {
    let (mode, tmpl, sName, sExec, sArgs, sIv, sTo, sMk, sOc) = detectStatusMode(cfg);
    let (pf, ef) = match cfg.statusFonts {
        Cons(h, t) -> (h, t),
        Nil -> ("", Nil),
    };
    let banner = if (res.migratedFromJson) {
        "已读取旧版 config.json；修改后将保存至 " + abbreviatedPath(res.savePath)
    } else {
        "修改会自动保存到配置文件并立即生效"
    };
    SettingsViewModel {
        selectedTab: cellNew(TabGeneral),
        launchAtLogin: loginModel,
        modifiers: cellNew(cfg.modifiers),
        workspaceMode: cellNew(cfg.workspaceMode),
        workspaceCount: cellNew(cfg.workspaceCount),
        masterRatioPercent: cellNew(roundFloat(cfg.masterRatio * 100.0)),
        ratioStepPercent: cellNew(roundFloat(cfg.ratioStep * 1000.0) / 10.0),
        masterCount: cellNew(cfg.masterCount),
        outerGap: cellNew(roundFloat(cfg.outerGap)),
        innerGap: cellNew(roundFloat(cfg.innerGap)),
        ignoreApps: cellNew(cfg.ignoreApps),
        appWorkspaces: cellNew(cfg.appWorkspaces),
        floatWindows: cellNew(cfg.floatWindows),
        statusShowIcon: cellNew(cfg.statusShowIcon),
        spaceLabels: cellNew(cfg.spaceLabels),
        workspaceIcons: cellNew(cfg.workspaceIcons),
        statusMode: cellNew(mode),
        customTemplate: cellNew(tmpl),
        workspaceCurrent: cellNew(cfg.workspaceCurrent),
        workspaceOther: cellNew(cfg.workspaceOther),
        primaryFont: cellNew(pf),
        extraFonts: cellNew(ef),
        statusFontSize: cellNew(cfg.statusFontSize),
        commands: cellNew(cfg.statusCommands),
        scriptName: cellNew(sName),
        scriptExecutable: cellNew(sExec),
        scriptArgumentsText: cellNew(sArgs),
        scriptInterval: cellNew(sIv),
        scriptTimeout: cellNew(sTo),
        scriptMarkup: cellNew(sMk),
        scriptOnChange: cellNew(sOc),
        statusTextFile: cellNew(match cfg.statusTextFile { Some(s) -> s, None -> "" }),
        statusStateFile: cellNew(match cfg.statusStateFile { Some(s) -> s, None -> "" }),
        savePath: cellNew(res.savePath),
        migratedFromJson: cellNew(res.migratedFromJson),
        statusBanner: cellNew(banner),
        validationMessage: cellNew(None),
        legacyFormat: cellNew(cfg.statusFormat),
        suppressAutoSave: cellNew(false),
        pendingSaveGen: cellNew(0),
        lastWrittenMs: cellNew(intToI64(0)),
        onConfigurationApplied: cellNew(None),
        onUIStateChanged: cellNew(None),
    }
}

pub def vmBuildConfiguration(vm: SettingsViewModel): Configuration = {
    let rawMods = cellGet(vm.modifiers);
    let orderedMods = listFilter(["control", "option", "command"], (m) -> listContainsBy(rawMods, m, eqStr));
    let finalMods = match orderedMods { Nil -> ["option"], _ -> orderedMods };
    let modeStr = if (cellGet(vm.workspaceMode) == "virtual") "virtual" else "native";
    let wsCnt = minInt(9, maxInt(1, cellGet(vm.workspaceCount)));
    let mRatio = minFloat(0.8, maxFloat(0.2, roundFloat(cellGet(vm.masterRatioPercent)) / 100.0));
    let rStep = minFloat(0.2, maxFloat(0.01, roundFloat(cellGet(vm.ratioStepPercent) * 10.0) / 1000.0));
    let mCnt = minInt(20, maxInt(1, cellGet(vm.masterCount)));
    let oGap = minFloat(64.0, maxFloat(0.0, roundFloat(cellGet(vm.outerGap))));
    let iGap = minFloat(64.0, maxFloat(0.0, roundFloat(cellGet(vm.innerGap))));

    let cleanLabels = listFilter(
        listMap(cellGet(vm.spaceLabels), (s) -> utf8TakeChars(strTrim(s), 16)),
        (s) -> strLen(s) > 0
    );
    let cleanIcons = listFilter(
        listMap(cellGet(vm.workspaceIcons), (s) -> utf8TakeChars(strTrim(s), 64)),
        (s) -> strLen(s) > 0
    );
    let pf = strTrim(cellGet(vm.primaryFont));
    let fonts = if (strLen(pf) == 0) Nil else Cons(pf, cellGet(vm.extraFonts));
    let fontSize = roundFloat(cellGet(vm.statusFontSize) * 2.0) / 2.0;

    let txtF = strTrim(cellGet(vm.statusTextFile));
    let txtOpt = if (strLen(txtF) == 0) None else Some(txtF);
    let stF = strTrim(cellGet(vm.statusStateFile));
    let stOpt = if (strLen(stF) == 0) None else Some(stF);

    let (statusFormat, statusTemplate, cmds) = match cellGet(vm.statusMode) {
        ModeSimple -> ("{spaces}  {layout}", None, Nil),
        ModeTemplate -> (cellGet(vm.legacyFormat), Some(cellGet(vm.customTemplate)), cellGet(vm.commands)),
        ModeScript -> {
            let trimmedName = strTrim(cellGet(vm.scriptName));
            let safeName = if (strLen(trimmedName) == 0) "mybar" else trimmedName;
            let parsedArgs = parseArgumentLine(cellGet(vm.scriptArgumentsText));
            let argsOpt = match parsedArgs { Nil -> None, _ -> Some(parsedArgs) };
            let cmd = StatusCommand {
                name: safeName,
                executable: strTrim(cellGet(vm.scriptExecutable)),
                arguments: argsOpt,
                interval: Some(cellGet(vm.scriptInterval)),
                timeout: Some(cellGet(vm.scriptTimeout)),
                markup: Some(cellGet(vm.scriptMarkup)),
                onChange: Some(cellGet(vm.scriptOnChange)),
            };
            (cellGet(vm.legacyFormat), Some("%" + safeName + "%"), [cmd])
        },
    };

    Configuration {
        modifiers: finalMods,
        workspaceMode: modeStr,
        workspaceCount: wsCnt,
        masterRatio: mRatio,
        ratioStep: rStep,
        masterCount: mCnt,
        outerGap: oGap,
        innerGap: iGap,
        ignoreApps: cellGet(vm.ignoreApps),
        appWorkspaces: cellGet(vm.appWorkspaces),
        floatWindows: cellGet(vm.floatWindows),
        statusFormat: statusFormat,
        statusTemplate: statusTemplate,
        statusShowIcon: cellGet(vm.statusShowIcon),
        workspaceCurrent: cellGet(vm.workspaceCurrent),
        workspaceOther: cellGet(vm.workspaceOther),
        statusFonts: fonts,
        statusFontSize: fontSize,
        statusCommands: cmds,
        spaceLabels: cleanLabels,
        workspaceIcons: cleanIcons,
        statusTextFile: txtOpt,
        statusStateFile: stOpt,
    }
}

def vmPerformSaveNow(vm: SettingsViewModel, candidate: Configuration): Void = {
    let path = cellGet(vm.savePath);
    match saveConfigToPath(candidate, path) {
        Ok(_) -> {
            cellSet(vm.lastWrittenMs, nowMs());
            cellSet(vm.migratedFromJson, false);
            cellSet(vm.statusBanner, "✓ 已自动保存至 " + abbreviatedPath(path) + " 并生效");
            cellSet(vm.validationMessage, None)
        },
        Err(e) -> cellSet(vm.validationMessage, Some("保存失败：" + e)),
    };
    match cellGet(vm.onUIStateChanged) { Some(cb) -> cb(), None -> () }
}

pub def vmNotifyChanged(vm: SettingsViewModel, immediate: Bool): Void =
    if (!cellGet(vm.suppressAutoSave)) {
        let candidate = vmBuildConfiguration(vm);
        match validateConfig(candidate) {
            Err(errMsg) -> {
                cellSet(vm.validationMessage, Some(errMsg));
                match cellGet(vm.onUIStateChanged) { Some(cb) -> cb(), None -> () }
            },
            Ok(_) -> {
                cellSet(vm.validationMessage, None);
                match cellGet(vm.onConfigurationApplied) {
                    Some(cb) -> cb(candidate, cellGet(vm.savePath)),
                    None -> (),
                };
                let nextGen = cellGet(vm.pendingSaveGen) + 1;
                cellSet(vm.pendingSaveGen, nextGen);
                if (immediate) {
                    cellSet(vm.pendingSaveGen, 0);
                    vmPerformSaveNow(vm, candidate)
                } else {
                    scheduleDelayedSignal(150, kSettingsDebounceSaveSignalTag())
                }
            },
        }
    } else ()

pub def vmHandleDebounceSignal(vm: SettingsViewModel): Void =
    if (cellGet(vm.pendingSaveGen) > 0) {
        cellSet(vm.pendingSaveGen, 0);
        let candidate = vmBuildConfiguration(vm);
        match validateConfig(candidate) {
            Ok(_) -> vmPerformSaveNow(vm, candidate),
            Err(e) -> cellSet(vm.validationMessage, Some(e)),
        }
    } else ()

pub def vmFlushPendingSave(vm: SettingsViewModel): Void =
    if (cellGet(vm.pendingSaveGen) > 0) {
        cellSet(vm.pendingSaveGen, 0);
        vmNotifyChanged(vm, true)
    } else ()

pub def vmReloadFromExternal(vm: SettingsViewModel, cfg: Configuration, res: ConfigResolution): Void = {
    cellSet(vm.suppressAutoSave, true);
    cellSet(vm.savePath, res.savePath);
    cellSet(vm.migratedFromJson, res.migratedFromJson);
    cellSet(vm.modifiers, cfg.modifiers);
    cellSet(vm.workspaceMode, cfg.workspaceMode);
    cellSet(vm.workspaceCount, cfg.workspaceCount);
    cellSet(vm.masterRatioPercent, roundFloat(cfg.masterRatio * 100.0));
    cellSet(vm.ratioStepPercent, roundFloat(cfg.ratioStep * 1000.0) / 10.0);
    cellSet(vm.masterCount, cfg.masterCount);
    cellSet(vm.outerGap, roundFloat(cfg.outerGap));
    cellSet(vm.innerGap, roundFloat(cfg.innerGap));
    cellSet(vm.ignoreApps, cfg.ignoreApps);
    cellSet(vm.appWorkspaces, cfg.appWorkspaces);
    cellSet(vm.floatWindows, cfg.floatWindows);
    cellSet(vm.statusShowIcon, cfg.statusShowIcon);
    cellSet(vm.spaceLabels, cfg.spaceLabels);
    cellSet(vm.workspaceIcons, cfg.workspaceIcons);
    cellSet(vm.legacyFormat, cfg.statusFormat);
    cellSet(vm.workspaceCurrent, cfg.workspaceCurrent);
    cellSet(vm.workspaceOther, cfg.workspaceOther);
    match cfg.statusFonts {
        Cons(h, t) -> { cellSet(vm.primaryFont, h); cellSet(vm.extraFonts, t) },
        Nil -> { cellSet(vm.primaryFont, ""); cellSet(vm.extraFonts, Nil) },
    };
    cellSet(vm.statusFontSize, cfg.statusFontSize);
    cellSet(vm.commands, cfg.statusCommands);
    cellSet(vm.statusTextFile, match cfg.statusTextFile { Some(s) -> s, None -> "" });
    cellSet(vm.statusStateFile, match cfg.statusStateFile { Some(s) -> s, None -> "" });
    let (mode, tmpl, sName, sExec, sArgs, sIv, sTo, sMk, sOc) = detectStatusMode(cfg);
    cellSet(vm.statusMode, mode);
    cellSet(vm.customTemplate, tmpl);
    cellSet(vm.scriptName, sName);
    cellSet(vm.scriptExecutable, sExec);
    cellSet(vm.scriptArgumentsText, sArgs);
    cellSet(vm.scriptInterval, sIv);
    cellSet(vm.scriptTimeout, sTo);
    cellSet(vm.scriptMarkup, sMk);
    cellSet(vm.scriptOnChange, sOc);
    cellSet(vm.validationMessage, None);
    cellSet(vm.statusBanner, "已从磁盘同步最新配置 (" + abbreviatedPath(res.savePath) + ")");
    cellSet(vm.suppressAutoSave, false);
    match cellGet(vm.onUIStateChanged) { Some(cb) -> cb(), None -> () }
}

pub def vmModifierSymbolPrefix(vm: SettingsViewModel): String = {
    let mods = cellGet(vm.modifiers);
    let s1 = if (listContainsBy(mods, "control", eqStr)) "⌃" else "";
    let s2 = if (listContainsBy(mods, "option", eqStr)) s1 + "⌥" else s1;
    if (listContainsBy(mods, "command", eqStr)) s2 + "⌘" else s2
}

pub def vmToggleModifier(vm: SettingsViewModel, modName: String): Void = {
    let cur = cellGet(vm.modifiers);
    if (listContainsBy(cur, modName, eqStr)) {
        if (listLen(cur) > 1) {
            cellSet(vm.modifiers, listFilter(cur, (m) -> m != modName));
            vmNotifyChanged(vm, true)
        } else ()
    } else {
        cellSet(vm.modifiers, listAppend(cur, [modName]));
        vmNotifyChanged(vm, true)
    }
}

pub def vmApplyTemplatePreset(vm: SettingsViewModel, preset: String): Void = {
    cellSet(vm.statusMode, ModeTemplate);
    if (preset == "icons") {
        cellSet(vm.customTemplate, "%spaces% <fc=#80808066>│</fc>  <fc=#14B8A6>%layout%</fc> · %count%");
        cellSet(vm.workspaceCurrent, "<fc=#FFFFFF,#0F766E> %icon%%fullscreen% </fc>");
        cellSet(vm.workspaceOther, " %icon%%fullscreen% ");
        if (listLen(cellGet(vm.workspaceIcons)) == 0) {
            cellSet(vm.workspaceIcons, ["terminal", "globe", "chevron.left.forwardslash.chevron.right", "bubble.left.and.bubble.right", "square.grid.2x2"])
        } else ()
    } else if (preset == "compact") {
        cellSet(vm.customTemplate, "%spaces%  <fc=#80808066>│</fc>  <fc=#0D9488>%layout%</fc> · %count%");
        cellSet(vm.workspaceCurrent, "<fc=#FFFFFF,#0F766E> %index%:%label%%fullscreen% </fc>");
        cellSet(vm.workspaceOther, " %index%:%label%%occupied%%fullscreen% ")
    } else if (preset == "underline") {
        cellSet(vm.customTemplate, "%spaces%  <fc=#80808066>│</fc>  <fc=#14B8A6>%layout%</fc> · %count%");
        cellSet(vm.workspaceCurrent, "<box type=Bottom width=2 color=#14B8A6> %index%:%label%%fullscreen% </box>");
        cellSet(vm.workspaceOther, " %index%:%label%%occupied%%fullscreen% ")
    } else if (preset == "pills") {
        cellSet(vm.customTemplate, "%spaces%  <fc=,#80808024> %layout% · %count% </fc>");
        cellSet(vm.workspaceCurrent, "<fc=#FFFFFF,#0F766E><box type=Full width=1 color=#2DD4BF80> %index%:%label%%fullscreen% </box></fc>");
        cellSet(vm.workspaceOther, "<fc=,#80808022> %index%:%label%%occupied%%fullscreen% </fc>")
    } else if (preset == "powerline") {
        cellSet(vm.customTemplate, "%spaces%  <fc=#D97706>▶ %layout%</fc>");
        cellSet(vm.workspaceCurrent, "<fc=#191C24,#F0C674> %index%:%label%%fullscreen% </fc>");
        cellSet(vm.workspaceOther, "<fc=,#80808028> %index%:%label%%occupied%%fullscreen% </fc>")
    } else if (preset == "clock") {
        cellSet(vm.customTemplate, "%spaces%  <fc=#80808066>│</fc>  <fc=#0D9488>%layout%</fc>  %clock%");
        cellSet(vm.workspaceCurrent, "<fc=#FFFFFF,#0F766E> %index%:%label%%fullscreen% </fc>");
        cellSet(vm.workspaceOther, " %index%:%label%%occupied%%fullscreen% ");
        let hasClock = listLen(listFilter(cellGet(vm.commands), (c: StatusCommand) -> c.name == "clock")) > 0;
        if (!hasClock) {
            let clk = StatusCommand {
                name: "clock",
                executable: "/bin/date",
                arguments: Some(["+%H:%M"]),
                interval: Some(30.0),
                timeout: Some(2.0),
                markup: None,
                onChange: None,
            };
            cellSet(vm.commands, listAppend(cellGet(vm.commands), [clk]))
        } else ()
    } else ();
    vmNotifyChanged(vm, true)
}

pub def vmPreviewImage(vm: SettingsViewModel, dark: Bool): Id NSObject = {
    let cand = vmBuildConfiguration(vm);
    let sampleSpaces = if (cand.workspaceMode == "virtual") {
        let rev: Cell (List SpaceEntry) = cellNew(Nil);
        let i = cellNew(0);
        while (cellGet(i) < cand.workspaceCount) {
            let idx = cellGet(i);
            let wc = if (idx == 0) 2 else if (idx == 1) 1 else 0;
            cellSet(rev, Cons(SpaceEntry {
                id: intToI64(idx + 1),
                isCurrent: idx == 0,
                isFullscreen: false,
                windowCount: Some(wc),
            }, cellGet(rev)));
            cellSet(i, idx + 1)
        };
        listRev(cellGet(rev))
    } else {
        [
            SpaceEntry { id: intToI64(1), isCurrent: true, isFullscreen: false, windowCount: None },
            SpaceEntry { id: intToI64(2), isCurrent: false, isFullscreen: false, windowCount: None },
            SpaceEntry { id: intToI64(3), isCurrent: false, isFullscreen: true, windowCount: None },
        ]
    };
    let vals = StatusValues {
        spaces: Some(sampleSpaces),
        layout: "Tall",
        title: "Safari",
        count: 3,
        custom: "示例状态",
        paused: false,
        spaceLabels: cand.spaceLabels,
        spaceIcons: cand.workspaceIcons,
    };
    let parts = templateStatusParts(cand, vals, (idx) ->
        match listNthOpt(cand.statusCommands, idx) {
            Some(c) -> if (c.name == "clock") "14:25" else "[" + c.name + "]",
            None -> "",
        }
    );
    let out = renderConfiguredStatus(parts, dark, cand.statusShowIcon, None);
    out.image
}

// ---------------------------------------------------------------------------
// AppKit UI Builder Helpers (SectionCard, TilingPreviewView, MenuBarPreviewPill)
